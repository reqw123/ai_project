        "name": "比對新舊引擎結果",
        "func": "// 比對新舊引擎：讀取 cat_health_v3_flow.json 舊引擎寫的 global.v2_risk\n// 跟本橋接流程寫的 global.v2_risk_py，整理成一份精簡對照，方便直接看\n// 兩邊算出來的 level/score 是否一致、差在哪裡——這是驗證 Python 版\n// 偏差引擎是否可信的關鍵步驟，不是可有可無的展示。\n\nlet oldRisk = global.get('v2_risk')    || null;\nlet newRisk = global.get('v2_risk_py') || null;\n\nlet comparison = {\n    old_engine: oldRisk ? {\n        level: oldRisk.level, score: oldRisk.score,\n        class_a_triggered: oldRisk.class_a_triggered,\n    } : '（尚無資料，cat_health_v3_flow.json 的行為偏差融合引擎還沒算過）',\n    new_engine: newRisk ? {\n        level: newRisk.level, score: newRisk.score,\n        class_a_triggered: newRisk.class_a_triggered,\n        top_contributors: newRisk.top_contributors,\n    } : '（尚無資料，見上方警告）',\n};\n\nif (oldRisk && newRisk) {\n    comparison.level_match = (oldRisk.level === newRisk.level);\n    comparison.score_diff  = +(newRisk.score - oldRisk.score).toFixed(1);\n    if (!comparison.level_match) {\n        node.warn('⚠ 新舊引擎判斷等級不同： 舊=' + oldRisk.level + ' 新=' + newRisk.level + '（score 差 ' + comparison.score_diff + '）');\n    }\n}\ncomparison.compared_at = new Date().toLocaleString('zh-TW');\n\nmsg.payload = comparison;\nreturn msg;\n",
