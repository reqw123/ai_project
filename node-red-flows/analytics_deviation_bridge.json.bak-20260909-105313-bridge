        "format": "<style>\n.cmp-wrap{font-family:'Microsoft JhengHei',sans-serif;padding:14px;background:#0d1117;border-radius:14px;height:100%;box-sizing:border-box}\n.cmp-title{font-size:13px;color:rgba(255,255,255,.5);margin-bottom:10px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}\n.cmp-badge-match{padding:3px 10px;border-radius:99px;font-size:11px;font-weight:700}\n.cmp-match-yes{background:rgba(76,175,80,.2);color:#81c784;border:1px solid rgba(76,175,80,.4)}\n.cmp-match-no{background:rgba(244,67,54,.2);color:#ef9a9a;border:1px solid rgba(244,67,54,.4)}\n.cmp-match-pending{background:rgba(255,255,255,.08);color:rgba(255,255,255,.4);border:1px solid rgba(255,255,255,.15)}\n.cmp-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.cmp-card{background:linear-gradient(135deg,#1a2332,#0d1b2a);border:1px solid rgba(255,255,255,.1);border-radius:14px;padding:16px}\n.cmp-card-hd{font-size:11px;color:rgba(255,255,255,.45);margin-bottom:8px;letter-spacing:.5px;text-transform:uppercase}\n.cmp-level{font-size:16px;font-weight:700;color:#fff;margin-bottom:6px}\n.cmp-score{font-size:30px;font-weight:800;color:#fff}\n.cmp-score-lbl{font-size:10px;color:rgba(255,255,255,.4);margin-top:2px}\n.cmp-risk-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:99px;font-size:12px;font-weight:700;margin-top:10px}\n.risk-normal{background:rgba(76,175,80,.2);color:#81c784;border:1px solid rgba(76,175,80,.4)}\n.risk-mild{background:rgba(255,167,38,.2);color:#ffa726;border:1px solid rgba(255,167,38,.4)}\n.risk-moderate{background:rgba(255,112,67,.2);color:#ff8a65;border:1px solid rgba(255,112,67,.4)}\n.risk-severe{background:rgba(244,67,54,.2);color:#ef9a9a;border:1px solid rgba(244,67,54,.4)}\n.cmp-empty{color:rgba(255,255,255,.35);font-size:13px;padding:30px 10px;text-align:center}\n.cmp-contrib{margin-top:10px;font-size:11px;color:rgba(255,255,255,.55)}\n.cmp-contrib-row{display:flex;justify-content:space-between;padding:4px 0;border-top:1px solid rgba(255,255,255,.06)}\n.cmp-footer{margin-top:12px;font-size:10px;color:rgba(255,255,255,.32);line-height:1.6}\n.cmp-diff{text-align:center;margin:12px 0;font-size:12px;color:rgba(255,255,255,.55)}\n.cmp-diff b{color:#fff}\n</style>\n<div class=\"cmp-wrap\" ng-init=\"init()\">\n  <div class=\"cmp-title\">\n    <span>🔬 新舊引擎比對</span>\n    <span class=\"cmp-badge-match\" ng-class=\"matchClass()\">{{matchLabel()}}</span>\n    <span ng-if=\"compared_at\" style=\"font-size:10px;color:rgba(255,255,255,.3);margin-left:auto\">更新於 {{compared_at}}</span>\n  </div>\n\n  <div class=\"cmp-row\">\n    <div class=\"cmp-card\">\n      <div class=\"cmp-card-hd\">舊引擎（Node-RED JS・z-score）</div>\n      <div ng-if=\"old\">\n        <div class=\"cmp-level\">{{levelZh(old.level)}}</div>\n        <div class=\"cmp-score\">{{old.score}}<span class=\"cmp-score-lbl\">/100</span></div>\n        <div class=\"cmp-risk-badge\" ng-class=\"riskCls(old.level)\">{{old.class_a_triggered ? 'Class A 觸發' : '無 Class A 觸發'}}</div>\n      </div>\n      <div class=\"cmp-empty\" ng-if=\"!old\">尚無資料<br><span style=\"font-size:10px\">（cat_health_v3_flow.json 的行為偏差融合引擎還沒算過）</span></div>\n    </div>\n\n    <div class=\"cmp-card\">\n      <div class=\"cmp-card-hd\">新引擎（Python・穩健統計）</div>\n      <div ng-if=\"new_\">\n        <div class=\"cmp-level\">{{levelZh(new_.level)}}</div>\n        <div class=\"cmp-score\">{{new_.score}}<span class=\"cmp-score-lbl\">/100</span></div>\n        <div class=\"cmp-risk-badge\" ng-class=\"riskCls(new_.level)\">{{new_.class_a_triggered ? 'Class A 觸發' : '無 Class A 觸發'}}</div>\n        <div class=\"cmp-contrib\" ng-if=\"new_.top_contributors\">\n          <div ng-repeat=\"c in new_.top_contributors.slice(0,3)\" class=\"cmp-contrib-row\">\n            <span>{{c[0]}}</span><span>{{c[1].toFixed(2)}}σ</span>\n          </div>\n        </div>\n      </div>\n      <div class=\"cmp-empty\" ng-if=\"!new_\">尚無資料<br><span style=\"font-size:10px\">（去「手動測試觸發」按一次 inject）</span></div>\n    </div>\n  </div>\n\n  <div class=\"cmp-diff\" ng-if=\"old && new_\">score 差異：<b>{{scoreDiff()}}</b></div>\n\n  <div class=\"cmp-footer\">\n    研究驗證用途：比對 cat_health_v3_flow.json 舊引擎（z-score）與 cat_monitoring_system/analytics\n    Python 新引擎（MAD 穩健 z-score／Poisson-NB 尾機率）的判斷結果。兩者目前並存、互不覆蓋，\n    正式告警仍以舊引擎（v2_risk）為準；詳見 cat_monitoring_system/analytics/README.md。\n  </div>\n</div>\n\n<script>\n(function(scope){\n  scope.old = null;\n  scope.new_ = null;\n  scope.compared_at = '';\n  scope.levelZh = function(lvl){\n    return {\n      'Normal':'行為正常',\n      'Mild Behavioral Deviation':'輕度行為偏差',\n      'Moderate Behavioral Deviation':'中度行為偏差',\n      'Severe Behavioral Deviation':'重度行為偏差'\n    }[lvl] || lvl || '計算中';\n  };\n  scope.riskCls = function(lvl){\n    return lvl==='Severe Behavioral Deviation' ? 'risk-severe' :\n           lvl==='Moderate Behavioral Deviation' ? 'risk-moderate' :\n           lvl==='Mild Behavioral Deviation' ? 'risk-mild' : 'risk-normal';\n  };\n  scope.matchClass = function(){\n    if(!scope.old || !scope.new_) return 'cmp-match-pending';\n    return scope.old.level === scope.new_.level ? 'cmp-match-yes' : 'cmp-match-no';\n  };\n  scope.matchLabel = function(){\n    if(!scope.old || !scope.new_) return '等待資料';\n    return scope.old.level === scope.new_.level ? '判斷一致' : '判斷不同';\n  };\n  scope.scoreDiff = function(){\n    if(!scope.old || !scope.new_) return '';\n    var d = (scope.new_.score - scope.old.score).toFixed(1);\n    return (d>=0?'+':'') + d;\n  };\n  scope.init = function(){};\n  scope.$watch('msg', function(m){\n    if(!m || !m.payload) return;\n    var p = m.payload;\n    scope.old  = (p.old_engine  && typeof p.old_engine  === 'object') ? p.old_engine  : null;\n    scope.new_ = (p.new_engine  && typeof p.new_engine  === 'object') ? p.new_engine  : null;\n    scope.compared_at = p.compared_at || '';\n  });\n})(scope);\n</script>\n",
