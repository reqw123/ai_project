        "name": "組成 /api/deviation 請求",
        "func": "// 組成 /api/deviation 的請求 body。\n// 對應 Python 端：cat_monitoring_system/server/routes.py -> POST /api/deviation\n//                 cat_monitoring_system/analytics/README.md 有完整設計說明\n//\n// 可從兩個地方觸發：\n//   1. 手動測試 inject 節點（本 tab 內建）\n//   2. link in 節點——若要接到既有 cat_health_v3_flow.json 的即時流程，\n//      在該 flow 裡「行為統計累積器」之後加一個 link out，\n//      target 指到本節點對應的 link in（id 需自行對應）。\n//\n// 2026-08-10 起：不再讀取／forward global.v2_daily_history 或 v2_today。\n// Python 端（/api/deviation）在請求沒帶 daily_history/today 時，會預設用\n// 自己獨立收集、獨立持久化的多天歷史（analytics/daily_store.py）跟即時\n// tracker 資料——這兩份資料源從此完全跟 Node-RED 的 global.json 脫鉤，\n// 任一邊被寫壞都不會波及另一邊（見\n// docs/資料層架構現況與統一管理評估.md 第九節）。原本這裡處理\n// v2_daily_history 日期格式混用（ISO vs toLocaleDateString('zh-TW')）\n// 的正規化邏輯也一併移除——那是專屬於 Node-RED 那份歷史的 workaround，\n// Python 自己收集的歷史從一開始就是 ISO 格式，不會有這個問題。\n//\n// 這裡只送 Node-RED 自己管的「設定值」（排除日期、基線天數、節律/轉移\n// 分數），不送任何統計歷史。\n\nlet cfg = global.get('v2_user_settings', 'file') || {};\nlet minBaselineDays = cfg.baseline_days != null ? +cfg.baseline_days : 7;\n\nfunction toISODate(raw) {\n    if (raw == null) return null;\n    let s = String(raw).trim();\n    if (/^\\d{4}-\\d{2}-\\d{2}/.test(s)) return s.slice(0, 10);\n    let m = s.match(/^(\\d{4})\\/(\\d{1,2})\\/(\\d{1,2})/);\n    if (m) {\n        let y = m[1], mo = m[2].padStart(2, '0'), d = m[3].padStart(2, '0');\n        return y + '-' + mo + '-' + d;\n    }\n    return null;\n}\nlet excludedDates = (global.get('v2_excluded_dates', 'file') || []).map(toISODate).filter(Boolean);\n\nlet pythonIp = global.get('python_ip', 'file') || global.get('python_ip');\nif (!pythonIp) {\n    node.warn('/api/deviation 橋接：global.python_ip 尚未設定（Python 端可能還沒送過 /python_online 上線通知），中止本次請求。');\n    return null;\n}\n\nmsg.url = 'http://' + pythonIp + ':5000/api/deviation';\nmsg.payload = {\n    excluded_dates: excludedDates,\n    min_baseline_days: minBaselineDays,\n    // Class C（節律/轉移模式）尚未搬遷到 Python，見 analytics/README.md「還沒做的事」。\n    // 暫時預設 0；若既有 flow 已算出節律/轉移分數並存到 global.v2_class_c_score，\n    // 這裡會自動帶入。\n    class_c_score: global.get('v2_class_c_score') || 0,\n};\nreturn msg;\n",
