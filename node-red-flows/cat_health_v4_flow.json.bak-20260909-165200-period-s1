    "func": "// ══════════════════════════════════════════════════════════════\n//  統計偏差分析引擎 v3.0\n//  完全移除固定百分比門檻，改用統計異常判斷\n//  每個指標輸出: today, mean, median, std, rolling_mean,\n//               z_score, robust_z, percentile, deviation_score\n// ══════════════════════════════════════════════════════════════\n\nlet data = msg.payload;\nlet td   = data.v2_today || {};\nlet bl;\nbl = global.get(\"gfile\").get('v2_baseline');\n\nif (!bl || !bl.metrics) {\n    msg.payload.deviation           = null;\n    msg.payload.deviation_available = false;\n    return msg;\n}\n\nlet m  = bl.metrics;\nlet l2 = bl.layer2 || {};\nlet l1 = bl.layer1 || {};\n\n// 鍵名對應表：metrics key → layer2/layer1 完整統計物件\nconst L2_MAP = {\n    lick_time:     'lick_duration',\n    lick_count:    'lick_frequency',\n    scratch_time:  'scratch_duration',\n    scratch_count: 'scratch_frequency',\n    shake_count:   'head_shake_frequency'\n};\nconst L1_MAP = {\n    walk_time: 'walk_duration',\n    stop_time: 'inactive_duration'\n};\n\nfunction getStats(key) {\n    let l2key = L2_MAP[key];\n    let l1key = L1_MAP[key];\n    if (l2key && l2[l2key]) return l2[l2key];\n    if (l1key && l1[l1key]) return l1[l1key];\n    return m[key] || {};\n}\n\n// Z-score：(今日值 − 歷史均值) / 歷史標準差\nfunction calcZScore(cur, key) {\n    let s = getStats(key);\n    if (!s || s.std === 0) return null;\n    return parseFloat(((cur - s.mean) / s.std).toFixed(2));\n}\n\n// Robust Z-score：0.6745 × (今日值 − Median) / IQR，抗離群值\nfunction calcRobustZ(cur, key) {\n    let s = getStats(key);\n    if (!s || !s.iqr || s.iqr === 0) return null;\n    return parseFloat((0.6745 * (cur - s.median) / s.iqr).toFixed(2));\n}\n\n// 百分位數：今日值落在歷史分布的哪個位置\nconst FIELD_MAP = {\n    lick_time:'lick_time', lick_count:'lick_count',\n    scratch_time:'scratch_time', scratch_count:'scratch_count',\n    shake_count:'shake_count', walk_time:'walk_time', stop_time:'stop_time',\n    lick_pct_day:'lick_pct_of_day', lick_pct_active:'lick_pct_of_active',\n    scratch_pct_day:'scratch_pct_of_day', scratch_pct_active:'scratch_pct_of_active',\n    active_ratio:'active_ratio', rest_ratio:'rest_ratio'\n};\nlet _history = global.get(\"gfile\").get('v2_daily_history') || [];\n\nfunction calcPercentile(cur, key) {\n    if (_history.length < 3) return null;\n    let field = FIELD_MAP[key] || key;\n    let vals  = _history.map(d => d[field] || 0).filter(v => typeof v === 'number' && !isNaN(v)).sort((a,b) => a - b);\n    if (vals.length === 0) return null;\n    return parseFloat((vals.filter(v => v <= cur).length / vals.length * 100).toFixed(1));\n}\n\n// 偏差分（0~100）：依 Z-score 線性映射\n// 0~1σ=正常(0~20), 1~2σ=輕度(20~50), 2~3σ=中度(50~80), >3σ=重度(80~100)\nfunction calcDeviationScore(z) {\n    if (z === null || z === undefined) return null;\n    let az = Math.abs(z);\n    if (az < 1.0) return parseFloat((az * 20).toFixed(1));\n    if (az < 2.0) return parseFloat((20 + (az - 1.0) * 30).toFixed(1));\n    if (az < 3.0) return parseFloat((50 + (az - 2.0) * 30).toFixed(1));\n    return parseFloat(Math.min(100, 80 + (az - 3.0) * 10).toFixed(1));\n}\n\n// 為每個指標建立完整統計記錄\nfunction buildRecord(cur, key) {\n    let s  = getStats(key);\n    let z  = calcZScore(cur, key);\n    let rz = calcRobustZ(cur, key);\n    let pc = calcPercentile(cur, key);\n    return {\n        today:           parseFloat((cur || 0).toFixed(2)),\n        mean:            s.mean        || 0,\n        median:          s.median      || 0,\n        std:             s.std         || 0,\n        rolling_mean:    s.rolling_mean|| 0,\n        z_score:         z,\n        robust_z:        rz,\n        percentile:      pc,\n        deviation_score: z !== null ? calcDeviationScore(z) : null\n    };\n}\n\nlet lick_t = td.lick    ? td.lick.time     : 0;\nlet lick_c = td.lick    ? td.lick.count    : 0;\nlet scr_t  = td.scratch ? td.scratch.time  : 0;\nlet scr_c  = td.scratch ? td.scratch.count : 0;\nlet shk_c  = td.shake   ? td.shake.count   : 0;\nlet shk_t  = td.shake   ? td.shake.time    : 0;\nlet walk_t = td.walk    ? td.walk.time     : 0;\nlet stop_t = td.stop    ? td.stop.time     : 0;\nlet mon_t  = td.monitoring_seconds || 0;\n// active_nr_t：排除 stop（靜止＝文獻 sleep/rest 的對應行為）之後的清醒活動時間，\n// 用來重現 Eckstein & Hart (2000) 的「佔非睡眠/休息時間比例」（~8%/~0.2%）\nlet active_nr_t = walk_t + lick_t + scr_t + shk_t;\nlet lick_pct_day_today     = mon_t > 0 ? (lick_t / mon_t * 100) : 0;\nlet lick_pct_active_today  = active_nr_t > 0 ? (lick_t / active_nr_t * 100) : 0;\nlet scr_pct_day_today      = mon_t > 0 ? (scr_t / mon_t * 100) : 0;\nlet scr_pct_active_today   = active_nr_t > 0 ? (scr_t / active_nr_t * 100) : 0;\nlet active_ratio_today     = mon_t > 0 ? (active_nr_t / mon_t * 100) : 0;\nlet rest_ratio_today       = mon_t > 0 ? (stop_t / mon_t * 100) : 0;\n\nlet dev = {\n    // 第二層：自理行為統計偏差（絕對值，保留供顯示/向後相容，不再是 Class A 主判準）\n    lick_duration:     buildRecord(lick_t, 'lick_time'),\n    lick_frequency:    buildRecord(lick_c, 'lick_count'),\n    scratch_duration:  buildRecord(scr_t,  'scratch_time'),\n    scratch_frequency: buildRecord(scr_c,  'scratch_count'),\n    head_shake:        buildRecord(shk_c,  'shake_count'),\n    // 第一層：活動基線統計偏差\n    walk_duration:     buildRecord(walk_t, 'walk_time'),\n    inactive_duration: buildRecord(stop_t, 'stop_time'),\n    // ── 百分比指標偏差（Eckstein & Hart, 2000 三層改革）：Class A 新主判準 ──\n    // 直接比較「今日行為佔活動/全天時間的比例」相對個體基線是否偏離，\n    // 不受「今天監控/在畫面時間比昨天長或短」影響，比絕對秒數更公平\n    lick_pct_day:       buildRecord(lick_pct_day_today,    'lick_pct_day'),\n    lick_pct_active:    buildRecord(lick_pct_active_today, 'lick_pct_active'),\n    scratch_pct_day:    buildRecord(scr_pct_day_today,     'scratch_pct_day'),\n    scratch_pct_active: buildRecord(scr_pct_active_today,  'scratch_pct_active'),\n    activity_ratio:     buildRecord(active_ratio_today,    'active_ratio'),\n    rest_ratio:         buildRecord(rest_ratio_today,       'rest_ratio'),\n\n    overall:       0,\n    baseline_days: bl.days_count || 0,\n    confidence:    bl.confidence || 'Low',\n    computed_at:   new Date().toISOString()\n};\n\n// 整體加權偏差分（各指標 deviation_score 加權平均，總和 = 1.0）\nconst WEIGHTS = { lick_pct_active:0.25, scratch_pct_active:0.25, head_shake:0.20, inactive_duration:0.15, walk_duration:0.15 };\nlet wSum = 0, wTotal = 0;\nfor (let [k, w] of Object.entries(WEIGHTS)) {\n    let ds = dev[k] && dev[k].deviation_score;\n    if (ds !== null && ds !== undefined) { wSum += ds * w; wTotal += w; }\n}\ndev.overall = wTotal > 0 ? parseFloat((wSum / wTotal).toFixed(1)) : 0;\n\n// 向後相容：保留 sigma 欄位（舊版 Dashboard 可能引用）\ndev.sigma = {\n    lick_time:    dev.lick_duration.z_score,\n    scratch_time: dev.scratch_duration.z_score,\n    shake_count:  dev.head_shake.z_score,\n    stop_time:    dev.inactive_duration.z_score\n};\n\nglobal.set('v2_deviation', dev);\nmsg.payload.deviation           = dev;\nmsg.payload.deviation_available = true;\nmsg.payload.baseline            = bl;\nmsg.payload.history_days        = _history.length;\nreturn msg;",
