    "func": "let action = msg.payload && msg.payload.action;\n\n// ── 測試 Discord 通知 ──────────────────────────────────────────\nif (action === 'test_discord') {\n    let url = (msg.payload.discord_webhook || '').trim();\n    if (!url) { node.warn('Discord URL 未填入，無法發送測試通知'); return [null, null]; }\n    msg.headers = {'Content-Type':'application/json'};\n    msg.url     = url;\n    msg.payload = {\n        username: 'Cat Health Monitor',\n        embeds: [{\n            title: '🔔 測試通知',\n            description: 'Cat Health Monitor 系統測試訊息\\n若看到此訊息，代表 Discord Webhook 設定正確！',\n            color: 3066993,\n            footer: {text: new Date().toLocaleString('zh-TW')}\n        }]\n    };\n    return [null, msg];  // output 2 → 送到 Discord\n}\n\n// ── 儲存設定 ──────────────────────────────────────────────────\nif (action === 'save_settings') {\n    let s    = msg.payload.settings || {};\n    let prev = global.get(\"gfile\").get('v2_user_settings') || {};\n    let validated = {\n        baseline_days:   Math.min(14, Math.max(3,  parseInt(s.baseline_days) || 7)),\n        lick_pct:        Math.min(50, Math.max(10, parseInt(s.lick_pct)      || 20)),\n        scratch_pct:     Math.min(40, Math.max(5,  parseInt(s.scratch_pct)   || 15)),\n        shake_pct:       Math.min(30, Math.max(3,  parseInt(s.shake_pct)     || 10)),\n        stop_pct:        Math.min(80, Math.max(30, parseInt(s.stop_pct)      || 55)),\n        lsc_count:       Math.min(30, Math.max(3,  parseInt(s.lsc_count)     || 10)),\n        discord_webhook: (s.discord_webhook || '').trim(),\n        notify_level:    Math.min(3, Math.max(1, parseInt(s.notify_level) || 2)),\n        cat_name:        (s.cat_name  || '').trim().slice(0,20),\n        cat_breed:       (s.cat_breed || '').trim().slice(0,30),\n        cat_birth_year:  parseInt(s.cat_birth_year)  || 0,\n        cat_birth_month: Math.min(12, Math.max(1, parseInt(s.cat_birth_month) || 1))\n    };\n    global.get(\"gfile\").set('v2_user_settings', validated);\n    node.warn('飼主設定已儲存：' + JSON.stringify(validated));\n\n    // URL 或靈敏度有變更 → 清除 dedup\n    if ((prev.discord_webhook !== validated.discord_webhook && validated.discord_webhook) ||\n        prev.notify_level !== validated.notify_level) {\n        flow.set('v2_last_discord_risk', '');\n        node.warn('Discord 設定已更新，已重置通知去重快取');\n    }\n\n    // 任何設定儲存都觸發基線重算（確保天數或閾值變更後立即生效）\n    node.warn('設定已儲存，觸發基線重算');\n    msg.payload = {};\n    return [msg, null];  // output 1 → 觸發基線重算\n}\n\n// ── 事件標記儲存 ──────────────────────────────────────────────────\nif (action === 'save_event_tag') {\n    let tags = msg.payload.tags || [];\n    let note = (msg.payload.note || '').trim();\n    let date = msg.payload.date || new Date().toLocaleDateString('zh-TW');\n    if (tags.length === 0 && !note) return [null, null];\n    let events = global.get(\"gfile\").get('v2_event_tags') || [];\n    events = events.filter(function(e){ return e.date !== date; });\n    events.push({date: date, tags: tags, note: note});\n    if (events.length > 90) events = events.slice(-90);\n    global.get(\"gfile\").set('v2_event_tags', events);\n    node.warn('事件標記已儲存：' + date + ' [' + tags.join(',') + ']');\n    return [null, null];\n}\n\n// ── 排除日期切換（立即觸發基線重算）────────────────────────────────\nif (action === 'toggle_exclude_date') {\n    let exDate = (msg.payload.date || '').trim();\n    if (!exDate) return [null, null];\n    let excluded = global.get(\"gfile\").get('v2_excluded_dates') || [];\n    let ei = excluded.indexOf(exDate);\n    if (ei < 0) {  // 新增排除 → 先檢查剩餘有效天數\n        let cfg = global.get(\"gfile\").get('v2_user_settings') || {};\n        let minDays = cfg.baseline_days != null ? +cfg.baseline_days : 7;\n        let history = global.get(\"gfile\").get('v2_daily_history') || [];\n        let newExcluded = excluded.concat([exDate]);\n        let validRemaining = history.filter(d =>\n            (d.monitoring_seconds || 0) >= 3600 &&\n            !newExcluded.includes(d.date)\n        ).length;\n        if (validRemaining < minDays) {\n            let rejectMsg = '排除後剩餘有效天數（' + validRemaining + ' 天）將少於基線設定天數（' + minDays + ' 天），請先降低基線天數或等待更多資料累積';\n            global.set('v2_exclude_rejected', rejectMsg);\n            node.warn('阻擋排除：' + rejectMsg);\n            return [null, null];\n        }\n    }\n    if (ei >= 0) excluded.splice(ei, 1);  // 已排除 → 取消排除\n    else excluded.push(exDate);             // 未排除 → 加入排除\n    global.get(\"gfile\").set('v2_excluded_dates', excluded);\n    node.warn('排除日期更新：' + JSON.stringify(excluded));\n    msg.payload = {};\n    return [msg, null];  // output 1 → 觸發基線重算\n}\n\n// ── 刪除指定某天的歷史記錄（永久刪除，含同步移除排除清單，觸發基線重算）──────\nif (action === 'delete_daily_record') {\n    let rawDate = (msg.payload.date || '').trim();\n    let m = rawDate.match(/^(\\d{4})\\/(0?[1-9]|1[0-2])\\/(0?[1-9]|[12]\\d|3[01])$/);\n    if (!m) {\n        let rejectMsg = '日期格式錯誤：「' + rawDate + '」。請輸入 YYYY/M/D 格式，例如 2026/6/12。';\n        global.set('v2_delete_rejected', rejectMsg);\n        node.warn('阻擋刪除（格式錯誤）：' + rejectMsg);\n        return [null, null];\n    }\n    let delY = parseInt(m[1], 10), delM = parseInt(m[2], 10), delD = parseInt(m[3], 10);\n    let checkDate = new Date(delY, delM - 1, delD);\n    if (checkDate.getFullYear() !== delY || checkDate.getMonth() !== delM - 1 || checkDate.getDate() !== delD) {\n        let rejectMsg = '「' + rawDate + '」不是真實存在的日期。';\n        global.set('v2_delete_rejected', rejectMsg);\n        node.warn('阻擋刪除（不存在的日期）：' + rejectMsg);\n        return [null, null];\n    }\n    let normDate = delY + '/' + delM + '/' + delD;  // 正規化成儲存格式（不補零），確保能比對到\n\n    let delHistory = global.get(\"gfile\").get('v2_daily_history') || [];\n    let delBefore = delHistory.length;\n    let delNewHistory = delHistory.filter(rec => rec.date !== normDate);\n    if (delNewHistory.length === delBefore) {\n        let rejectMsg = '找不到 ' + normDate + ' 的歷史資料，未執行任何刪除。';\n        global.set('v2_delete_rejected', rejectMsg);\n        node.warn('阻擋刪除（查無資料）：' + rejectMsg);\n        return [null, null];\n    }\n    global.get(\"gfile\").set('v2_daily_history', delNewHistory);\n\n    let delExcluded = global.get(\"gfile\").get('v2_excluded_dates') || [];\n    let delEi = delExcluded.indexOf(normDate);\n    if (delEi >= 0) {\n        delExcluded.splice(delEi, 1);\n        global.get(\"gfile\").set('v2_excluded_dates', delExcluded);\n    }\n\n    let successMsg = '已刪除 ' + normDate + ' 的歷史資料（剩餘 ' + delNewHistory.length + ' 天），基線重新計算中...';\n    global.set('v2_delete_success', successMsg);\n    node.warn('已刪除歷史記錄：' + normDate + '，剩餘 ' + delNewHistory.length + ' 天');\n    msg.payload = {};\n    return [msg, null];  // output 1 → 觸發基線重算\n}\n\nreturn [null, null];",
