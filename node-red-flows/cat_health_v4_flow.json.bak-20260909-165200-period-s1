    "func": "let data = msg.payload;\nif (!data || !data.today_stats) return [null, null, null, null];\nlet stats   = data.today_stats;\nlet current = data.current || {};\n\n// v2_today（數值來自 Python tracker）\nlet todayDate = new Date().toLocaleDateString('zh-TW');\nlet today = {\n    date:              todayDate,\n    walk:    { count: Number(stats.walk    || 0), time: Number(stats.walk_time    || 0) },\n    lick:    { count: Number(stats.lick    || 0), time: Number(stats.lick_time    || 0) },\n    scratch: { count: Number(stats.scratch || 0), time: Number(stats.scratch_time || 0) },\n    shake:   { count: Number(stats.shake   || 0), time: Number(stats.shake_time   || 0) },\n    stop:    { count: Number(stats.stop    || 0), time: Number(stats.stop_time    || 0) },\n    active_time:        Number(stats.active_time        || 0),\n    low_conf:           { count: Number(stats.low_conf || 0), time: Number(stats.low_conf_time || 0) },\n    not_detected_time:  Number(stats.not_detected_time  || 0),\n    monitoring_seconds: Number(stats.monitoring_seconds || 0),\n    cat_visible_time:   Number(stats.cat_visible_time   || 0),\n    total_uptime:       Number(stats.total_uptime       || 0)\n};\n// 百分比指標（Eckstein & Hart, 2000）：即時版，供 P1/P2/P3 Dashboard 直接顯示，\n// 定義與「每日統計彙整」節點一致（active_non_rest_time 排除 stop）\ntoday.active_non_rest_time = today.walk.time + today.lick.time + today.scratch.time + today.shake.time;\ntoday.active_ratio = today.monitoring_seconds > 0 ? parseFloat((today.active_non_rest_time / today.monitoring_seconds * 100).toFixed(2)) : 0;\ntoday.rest_ratio    = today.monitoring_seconds > 0 ? parseFloat((today.stop.time / today.monitoring_seconds * 100).toFixed(2)) : 0;\ntoday.lick_pct_of_day       = today.monitoring_seconds > 0    ? parseFloat((today.lick.time     / today.monitoring_seconds    * 100).toFixed(3)) : 0;\ntoday.scratch_pct_of_day    = today.monitoring_seconds > 0    ? parseFloat((today.scratch.time  / today.monitoring_seconds    * 100).toFixed(3)) : 0;\ntoday.lick_pct_of_active    = today.active_non_rest_time > 0  ? parseFloat((today.lick.time     / today.active_non_rest_time  * 100).toFixed(3)) : 0;\ntoday.scratch_pct_of_active = today.active_non_rest_time > 0  ? parseFloat((today.scratch.time  / today.active_non_rest_time  * 100).toFixed(3)) : 0;\nglobal.get(\"gfile\").set('v2_today', today);\n\n// 轉移矩陣、每小時分布：Python 計算好直接存入 context\nglobal.set('v2_transition_matrix', stats.transition_matrix   || {});\nglobal.set('v2_hourly',            stats.hourly_distribution || {});\n\n// emoji fallback\nlet emojiMap = {walk:'🚶',lick:'😸',scratch:'🐾',shake:'🔄',stop:'😴',not:'📷'};\nif (!current.emoji) current.emoji = emojiMap[current.behavior] || '🐱';\n\nmsg.payload           = data;\nmsg.payload.v2_today  = today;\nmsg.payload.v2_hourly = stats.hourly_distribution || {};\nmsg.payload.v2_matrix = stats.transition_matrix   || {};\n\n\nreturn [msg, msg, msg, null];",
