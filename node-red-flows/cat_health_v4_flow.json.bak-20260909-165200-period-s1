    "format": "<style>\n.p2-wrap,.p2-wrap *{box-sizing:border-box}.p2-wrap{font-family:Inter,\"Noto Sans TC\",\"Microsoft JhengHei\",sans-serif;color:var(--ch-text,#f4f8fc);padding:clamp(12px,2vw,22px);background:linear-gradient(145deg,rgba(11,27,45,.96),rgba(6,16,29,.98));border:1px solid var(--ch-line,rgba(148,178,210,.14));border-radius:20px;box-shadow:0 18px 46px rgba(0,0,0,.24)}\n.p2-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:17px}.p2-title{font-size:17px;font-weight:900}.p2-kicker{font-size:10px;color:var(--ch-cyan,#55d6c2);letter-spacing:.13em;text-transform:uppercase;font-weight:800;margin-bottom:5px}.p2-date{font-size:11px;color:var(--ch-muted,#8da2b8)}\n.p2-summary{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;margin-bottom:14px}.p2-sum-box{min-width:0;background:linear-gradient(145deg,rgba(18,34,56,.9),rgba(10,24,41,.86));border:1px solid var(--ch-line,rgba(148,178,210,.14));border-radius:16px;padding:15px;position:relative;overflow:hidden;transition:transform .2s,border-color .2s}.p2-sum-box:hover{transform:translateY(-2px);border-color:rgba(85,214,194,.28)}\n.p2-sum-box:after{content:\"\";position:absolute;right:-18px;bottom:-28px;width:72px;height:72px;border-radius:50%;background:radial-gradient(circle,rgba(85,214,194,.09),transparent 68%)}\n.p2-sum-ico{font-size:15px;opacity:.76;margin-bottom:10px}.p2-sum-val{font-size:clamp(19px,2.2vw,28px);font-weight:900;letter-spacing:-.035em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}.p2-sum-lbl{font-size:10px;color:var(--ch-muted,#8da2b8);margin-top:6px;line-height:1.35}\n.p2-panel{background:rgba(10,24,41,.7);border:1px solid var(--ch-line,rgba(148,178,210,.14));border-radius:18px;padding:17px;margin-top:14px}.p2-panel-head{display:flex;justify-content:space-between;align-items:flex-end;gap:10px;margin-bottom:14px}.p2-panel-title{font-size:13px;font-weight:850}.p2-panel-hint{font-size:10px;color:var(--ch-muted,#8da2b8)}\n.p2-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px}.p2-card{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.065);border-radius:14px;padding:13px 12px;min-width:0}.p2-card-top{display:flex;align-items:center;justify-content:space-between;gap:7px}.p2-card-ico{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;font-size:18px;background:var(--behavior-soft)}.p2-card-pct{font-size:11px;font-weight:800;color:var(--behavior)}\n.p2-card-cnt{font-size:23px;font-weight:900;margin-top:11px;letter-spacing:-.03em}.p2-card-lbl{font-size:10px;color:var(--ch-muted,#8da2b8);margin-top:2px}.p2-card-bar{height:6px;border-radius:99px;background:rgba(142,163,184,.11);overflow:hidden;margin-top:11px}.p2-card-fill{height:100%;border-radius:99px;transition:width .65s cubic-bezier(.2,.8,.2,1)}.p2-card-time{font-size:10px;color:#c0cfdd;margin-top:7px;font-variant-numeric:tabular-nums}\n.p2-compare{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.p2-compare-card{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.065);border-radius:14px;padding:13px}.p2-compare-name{font-size:11px;font-weight:750;color:#d8e4ee;margin-bottom:12px}.p2-compare-value{font-size:22px;font-weight:900}.p2-compare-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}.p2-chip{font-size:9px;padding:5px 7px;border-radius:999px;background:rgba(99,167,255,.1);color:#9fc8ff;border:1px solid rgba(99,167,255,.16)}.p2-chip.lit{background:rgba(167,139,250,.09);color:#c7b8ff;border-color:rgba(167,139,250,.17)}.p2-pct-hint{font-size:10px;color:var(--ch-muted,#8da2b8);line-height:1.6;margin-top:10px;padding-left:10px;border-left:2px solid rgba(85,214,194,.28)}\n.p2-hour-chart{height:180px;display:grid;grid-template-columns:repeat(24,minmax(8px,1fr));gap:3px;align-items:end;padding:8px 2px 0;border-bottom:1px solid rgba(148,178,210,.12);background:linear-gradient(to top,rgba(255,255,255,.018) 1px,transparent 1px);background-size:100% 36px}.p2-hour-col{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;min-width:0;position:relative}.p2-stack-shell{height:140px;width:100%;display:flex;align-items:flex-end;justify-content:center}.p2-stack{width:min(14px,76%);min-height:3px;display:flex;flex-direction:column-reverse;border-radius:5px 5px 2px 2px;overflow:hidden;transition:height .55s cubic-bezier(.2,.8,.2,1);box-shadow:0 5px 14px rgba(0,0,0,.12)}.p2-segment{display:block;min-height:0;transition:height .55s}.p2-hour-lbl{height:22px;font-size:8px;color:#60778e;margin-top:5px}.p2-hour-col:nth-child(3n+1) .p2-hour-lbl{color:#91a6ba}.p2-now-marker{position:absolute;top:0;width:5px;height:5px;border-radius:50%;background:var(--ch-cyan,#55d6c2);box-shadow:0 0 0 4px rgba(85,214,194,.1)}\n.p2-legend{display:flex;flex-wrap:wrap;gap:12px;margin-top:12px}.p2-legend-item{display:flex;align-items:center;gap:6px;font-size:10px;color:var(--ch-muted,#8da2b8)}.p2-legend-dot{width:8px;height:8px;border-radius:3px}\n@media(max-width:1050px){.p2-summary{grid-template-columns:repeat(3,1fr)}.p2-grid{grid-template-columns:repeat(3,1fr)}}\n@media(max-width:700px){.p2-wrap{padding:13px;border-radius:16px}.p2-head{align-items:flex-start}.p2-summary{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.p2-sum-box{padding:12px;border-radius:14px}.p2-sum-box:first-child{grid-column:1/-1}.p2-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.p2-card:last-child{grid-column:1/-1}.p2-compare{grid-template-columns:1fr}.p2-panel{padding:13px;border-radius:15px}.p2-hour-chart{gap:2px;overflow:hidden}.p2-stack{width:70%}.p2-hour-lbl{font-size:7px}.p2-panel-hint{display:none}}\n@media(max-width:390px){.p2-summary,.p2-grid{grid-template-columns:1fr}.p2-sum-box:first-child,.p2-card:last-child{grid-column:auto}.p2-hour-chart{height:160px}.p2-stack-shell{height:120px}}\n@media(prefers-reduced-motion:reduce){.p2-wrap *{animation:none!important;transition:none!important}}\n</style>\n\n<div class=\"p2-wrap\" ng-init=\"init()\">\n  <header class=\"p2-head\"><div><div class=\"p2-kicker\">Daily intelligence</div><div class=\"p2-title\">今日健康摘要</div></div><div class=\"p2-date\">{{todayDate()}} · 持續更新</div></header>\n\n  <section class=\"p2-summary\">\n    <div class=\"p2-sum-box\"><div class=\"p2-sum-ico\">◇</div><div class=\"p2-sum-val\" ng-style=\"{color:riskColor()}\">{{riskScore()}}</div><div class=\"p2-sum-lbl\">行為偏差分 / 100</div></div>\n    <div class=\"p2-sum-box\"><div class=\"p2-sum-ico\">⌁</div><div class=\"p2-sum-val\">{{fmtTime(totalActive())}}</div><div class=\"p2-sum-lbl\">今日活動時間</div></div>\n    <div class=\"p2-sum-box\"><div class=\"p2-sum-ico\">⇄</div><div class=\"p2-sum-val\">{{totalBehaviors()}}</div><div class=\"p2-sum-lbl\">行為辨識次數</div></div>\n    <div class=\"p2-sum-box\"><div class=\"p2-sum-ico\">◷</div><div class=\"p2-sum-val\" ng-style=\"{color:monColor()}\">{{fmtTime(monSec())}}</div><div class=\"p2-sum-lbl\">系統監控時長</div></div>\n    <div class=\"p2-sum-box\"><div class=\"p2-sum-ico\">◉</div><div class=\"p2-sum-val\" ng-style=\"{color:catVisibleColor()}\">{{fmtTime(catVisibleSec())}}</div><div class=\"p2-sum-lbl\">貓咪入鏡時間</div></div>\n  </section>\n\n  <section class=\"p2-panel\">\n    <div class=\"p2-panel-head\"><div class=\"p2-panel-title\">行為分類統計</div><div class=\"p2-panel-hint\">次數、累積時間與今日組成</div></div>\n    <div class=\"p2-grid\">\n      <article class=\"p2-card\" ng-repeat=\"b in behaviors\">\n        <div class=\"p2-card-top\"><div class=\"p2-card-ico\" ng-style=\"{background:b.soft}\">{{b.ico}}</div><div class=\"p2-card-pct\" ng-style=\"{color:b.color}\">{{pct(b.key)}}%</div></div>\n        <div class=\"p2-card-cnt\">{{behaviorCount(b.key)}}</div><div class=\"p2-card-lbl\">{{b.name}}次數</div>\n        <div class=\"p2-card-bar\"><div class=\"p2-card-fill\" ng-style=\"{width:pct(b.key)+'%',background:b.color}\"></div></div><div class=\"p2-card-time\">累積 {{fmtTime(behaviorTime(b.key))}}</div>\n      </article>\n    </div>\n  </section>\n\n  <section class=\"p2-panel\">\n    <div class=\"p2-panel-head\"><div class=\"p2-panel-title\">個體基線對照</div><div class=\"p2-panel-hint\">文獻數值僅供參考，偏差仍以個體基線判斷</div></div>\n    <div class=\"p2-compare\">\n      <article class=\"p2-compare-card\"><div class=\"p2-compare-name\">🏃 活動時間佔比</div><div class=\"p2-compare-value\">{{todayPct('active_ratio').toFixed(2)}}%</div><div class=\"p2-compare-meta\"><span class=\"p2-chip\">基線 {{fmtBlPct('active_ratio','mean')}}% ± {{fmtBlPct('active_ratio','std')}}</span><span class=\"p2-chip lit\">文獻約 43%</span></div></article>\n      <article class=\"p2-compare-card\"><div class=\"p2-compare-name\">😸 舔舐佔活動時間</div><div class=\"p2-compare-value\">{{todayPct('lick_pct_of_active').toFixed(2)}}%</div><div class=\"p2-compare-meta\"><span class=\"p2-chip\">基線 {{fmtBlPct('lick_pct_active','mean')}}% ± {{fmtBlPct('lick_pct_active','std')}}</span><span class=\"p2-chip lit\">文獻約 8%</span></div></article>\n      <article class=\"p2-compare-card\"><div class=\"p2-compare-name\">🐾 搔抓佔活動時間</div><div class=\"p2-compare-value\">{{todayPct('scratch_pct_of_active').toFixed(2)}}%</div><div class=\"p2-compare-meta\"><span class=\"p2-chip\">基線 {{fmtBlPct('scratch_pct_active','mean')}}% ± {{fmtBlPct('scratch_pct_active','std')}}</span><span class=\"p2-chip lit\">文獻約 0.2%</span></div></article>\n    </div>\n    <div class=\"p2-pct-hint\">比例計算排除靜止行為，以非休息活動時間作為分母；群體參考值不直接作為警報門檻。</div>\n  </section>\n\n  <section class=\"p2-panel\">\n    <div class=\"p2-panel-head\"><div class=\"p2-panel-title\">24 小時行為分布</div><div class=\"p2-panel-hint\">柱高代表該小時總辨識時間，顏色代表各行為組成</div></div>\n    <div class=\"p2-hour-chart\">\n      <div class=\"p2-hour-col\" ng-repeat=\"h in hours track by $index\" title=\"{{hourTitle(h)}}\">\n        <span class=\"p2-now-marker\" ng-if=\"isCurrentHour(h)\"></span>\n        <div class=\"p2-stack-shell\"><div class=\"p2-stack\" ng-style=\"{height:hHeight(h)+'px'}\"><span class=\"p2-segment\" ng-repeat=\"b in behaviors\" ng-style=\"{height:hPart(h,b.key)+'%',background:b.color}\"></span></div></div>\n        <span class=\"p2-hour-lbl\">{{$index%3===0?h:''}}</span>\n      </div>\n    </div>\n    <div class=\"p2-legend\"><div class=\"p2-legend-item\" ng-repeat=\"b in behaviors\"><span class=\"p2-legend-dot\" ng-style=\"{background:b.color}\"></span>{{b.name}}</div></div>\n  </section>\n</div>\n\n<script>\n(function(scope){\n  scope.init=function(){};scope.hours=Array.from({length:24},function(_,i){return String(i).padStart(2,'0');});\n  scope.behaviors=[\n    {key:'walk',name:'行走',ico:'🚶',color:'#55d6c2',soft:'rgba(85,214,194,.13)'},\n    {key:'lick',name:'舔舐',ico:'😸',color:'#a78bfa',soft:'rgba(167,139,250,.13)'},\n    {key:'scratch',name:'搔抓',ico:'🐾',color:'#f472b6',soft:'rgba(244,114,182,.13)'},\n    {key:'shake',name:'甩頭',ico:'↻',color:'#63a7ff',soft:'rgba(99,167,255,.13)'},\n    {key:'stop',name:'靜止',ico:'☾',color:'#71839a',soft:'rgba(113,131,154,.13)'}\n  ];\n  scope.payload=function(){return scope.msg&&scope.msg.payload?scope.msg.payload:{};};\n  scope.td=function(){return scope.payload().v2_today||{walk:{count:0,time:0},lick:{count:0,time:0},scratch:{count:0,time:0},shake:{count:0,time:0},stop:{count:0,time:0}};};\n  scope.todayDate=function(){return scope.td().date||new Date().toLocaleDateString('zh-TW');};\n  scope.behaviorCount=function(k){return Number(scope.td()[k]&&scope.td()[k].count||0);};scope.behaviorTime=function(k){return Number(scope.td()[k]&&scope.td()[k].time||0);};\n  scope.totalActive=function(){return Number(scope.td().active_time||0);};\n  scope.totalBehaviors=function(){return ['walk','lick','scratch','shake','stop'].reduce(function(s,k){return s+scope.behaviorCount(k);},0);};\n  scope.pct=function(b){var total=['walk','lick','scratch','shake','stop'].reduce(function(s,k){return s+scope.behaviorTime(k);},0);return total?(scope.behaviorTime(b)/total*100).toFixed(2):'0.00';};\n  scope.riskScore=function(){var r=scope.payload().risk;return r&&r.score!=null?Math.round(r.score):'--';};scope.riskColor=function(){var r=scope.payload().risk;return r&&r.color?r.color:'#71839a';};\n  scope.bl=function(){return scope.payload().baseline||null;};scope.fmtBlPct=function(key,field){var b=scope.bl();return b&&b.metrics&&b.metrics[key]&&b.metrics[key][field]!=null?(+b.metrics[key][field]).toFixed(2):'--';};\n  scope.todayPct=function(field){var v=scope.td()[field];return v!=null&&isFinite(Number(v))?Number(v):0;};\n  scope.monSec=function(){return Number(scope.td().total_uptime||0);};scope.monColor=function(){var h=scope.monSec()/3600;return h>=4?'#4ade80':h>=2?'#facc15':'#fb923c';};\n  scope.catVisibleSec=function(){return Number(scope.td().cat_visible_time||0);};scope.catVisibleColor=function(){var mon=scope.monSec(),ratio=mon>0?scope.catVisibleSec()/mon:0;return ratio>=.5?'#4ade80':ratio>=.2?'#facc15':'#fb923c';};\n  scope.fmtTime=function(s){s=Number(s)||0;var h=Math.floor(s/3600),m=Math.floor(s%3600/60),sec=Math.floor(s%60);return h?h+'時'+m+'分':m?m+'分'+sec+'秒':sec+'秒';};\n  scope.hourData=function(h){var hr=scope.payload().v2_hourly||{};return hr[h]||{};};scope.hTotal=function(h){var d=scope.hourData(h);return scope.behaviors.reduce(function(s,b){return s+Number(d[b.key]||0);},0);};\n  scope.hourMax=function(){var max=1;scope.hours.forEach(function(h){max=Math.max(max,scope.hTotal(h));});return max;};scope.hHeight=function(h){var total=scope.hTotal(h);return total?Math.max(4,Math.round(total/scope.hourMax()*134)):3;};\n  scope.hPart=function(h,k){var total=scope.hTotal(h);return total?Number(scope.hourData(h)[k]||0)/total*100:0;};scope.isCurrentHour=function(h){return Number(h)===new Date().getHours();};\n  scope.hourTitle=function(h){var d=scope.hourData(h),parts=scope.behaviors.map(function(b){return b.name+' '+scope.fmtTime(d[b.key]||0);});return h+':00｜'+parts.join('、');};\n})(scope);\n</script>",
