    "name": "行為節律分析",
    "func": "let data   = msg.payload;\nlet hourly = data.v2_hourly || {};\nlet periods = {\n    '00-06': {walk:0,lick:0,scratch:0,shake:0,stop:0,total:0},\n    '06-12': {walk:0,lick:0,scratch:0,shake:0,stop:0,total:0},\n    '12-18': {walk:0,lick:0,scratch:0,shake:0,stop:0,total:0},\n    '18-24': {walk:0,lick:0,scratch:0,shake:0,stop:0,total:0}\n};\nfor (let h=0; h<24; h++) {\n    let k  = String(h).padStart(2,'0');\n    let hd = hourly[k] || {};\n    let pd = h<6?'00-06':h<12?'06-12':h<18?'12-18':'18-24';\n    let bs = ['walk','lick','scratch','shake','stop'];\n    for (let b of bs) {\n        let v = hd[b] || 0;\n        periods[pd][b]     += v;\n        periods[pd].total  += v;\n    }\n}\nlet rhythm = {};\nfor (let [pd, d] of Object.entries(periods)) {\n    if (d.total === 0) { rhythm[pd] = {dominant:'none',pct:{},total:0}; continue; } // 'none' = 該時段無任何行為資料（未監控或貓始終不在畫面）\n    let bs  = ['walk','lick','scratch','shake','stop'];\n    let dom = bs.reduce((a,b) => d[a]>=d[b]?a:b, 'stop'); // 該時段佔時間最長的行為\n    let pct = {}; // 各行為佔該時段總秒數的百分比\n    for (let b of bs) pct[b] = parseFloat((d[b]/d.total*100).toFixed(2));\n    rhythm[pd] = {dominant:dom, pct, total:parseFloat(d.total.toFixed(1))};\n}\nflow.set('v2_rhythm', rhythm);\nmsg.payload.rhythm = rhythm;\nreturn msg;",
