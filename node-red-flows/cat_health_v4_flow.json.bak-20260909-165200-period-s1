    "func": "let data = msg.payload;\nlet td   = data.v2_today || {};\nlet times = {\n    walk:    td.walk    ? td.walk.time    : 0,\n    lick:    td.lick    ? td.lick.time    : 0,\n    scratch: td.scratch ? td.scratch.time : 0,\n    shake:   td.shake   ? td.shake.time   : 0,\n    stop:    td.stop    ? td.stop.time    : 0\n};\nlet total = Object.values(times).reduce((a,b)=>a+b, 0);\nlet dist  = {};\nif (total > 0) {\n    for (let [k,v] of Object.entries(times)) dist[k] = parseFloat((v/total*100).toFixed(2));\n} else {\n    dist = {walk:0,lick:0,scratch:0,shake:0,stop:0};\n}\nflow.set('v2_distribution', dist);\nmsg.payload.distribution = dist;\nreturn msg;",
