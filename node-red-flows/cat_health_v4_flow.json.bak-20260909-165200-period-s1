    "z": "457d7a0cc77babac",
    "name": "行為偏差融合引擎",
    "func": "// ══════════════════════════════════════════════════════════════\n//  行為偏差融合引擎 v3.1（Scientific Priority Enhancement）\n//  ★ 三層研究架構：\n//     ① Population Reference → 文獻參考值（不直接判斷）\n//     ② Individual Baseline  → 個體化基線（真正判斷依據）\n//     ③ Behavioral Deviation → 行為偏差輸出（非疾病診斷）\n//  ★ 行為優先級：Class A（Critical）/ Class B（Supporting）/ Class C（Pattern）\n//  ★ Class A Override Rule：高重要性行為允許單獨觸發警報（防止 False Negative）\n//  ★ Single Behavior Critical Rule：舔舐/搔抓顯著偏離可獨立觸發偏差判定\n//  文獻：Eckstein & Hart (2000), VAScat, ISFM Feline Behaviour Guidelines\n// ══════════════════════════════════════════════════════════════\n\nlet cfg   = global.get(\"gfile\").get('v2_user_settings') || {};\nlet data  = msg.payload;\nlet dev   = data.deviation;\nlet dist  = data.distribution || flow.get('v2_distribution') || {};\nlet rhythm= data.rhythm       || flow.get('v2_rhythm')       || {};\nlet mx    = data.v2_matrix    || global.get('v2_transition_matrix') || {};\nlet td    = data.v2_today     || {};\nlet bl    = data.baseline     || {};\nif (!bl.computed_at) bl = global.get(\"gfile\").get('v2_baseline') || {};\n\n// ── Population Reference（群體文獻參考值，不直接參與異常判斷）──\nconst POPULATION_REFERENCE = {\n    lick_duration:    { mean_sec:3600, mean_display:'~60 min/day', source:'Eckstein & Hart (2000)', note:'健康室內成貓口腔梳理（群體參考，非異常門檻）' },\n    scratch_duration: { mean_sec:60,   mean_display:'~1 min/day',  source:'Eckstein & Hart (2000)', note:'健康室內成貓搔抓梳理（群體參考，非異常門檻）' },\n    lick_pct_active:    { mean_pct:8,   mean_display:'~8% of non-rest active time',  source:'Eckstein & Hart (2000)', note:'口腔梳理佔非睡眠/休息時間比例（群體參考，非異常門檻；Class A 主判準）' },\n    scratch_pct_active: { mean_pct:0.2, mean_display:'~0.2% of non-rest active time',source:'Eckstein & Hart (2000)', note:'搔抓梳理佔非睡眠/休息時間比例（群體參考，非異常門檻；Class A 主判準）' }\n};\n\n// ── 行為優先級分類（Behavior Priority Classification）──\n// Class A: Critical Behaviour\n//   - 與皮膚舒適度直接相關\n//   - 允許單獨觸發警報（Single Behavior Critical Rule）\n//   - Override Rule：Z≥2.5σ→Mild, Z≥3.0σ→Moderate, Z≥4.0σ→Severe\n// Class B: Supporting Behaviour\n//   - 輔助性偏差指標，提升警報 Confidence\n//   - 不得獨立觸發警報\n// Class C: Pattern Behaviour\n//   - 整體行為模式分析（節律、轉移）\n//   - 增強 Behavior Interpretation 品質\n// v3.2：Class A 主判準改為「佔活動時間百分比」z-score（取代絕對時長），\n// 直接對應 Eckstein & Hart (2000) 的 8%/0.2% 文獻定義，不受監控/在畫面時間\n// 長短影響——監控越久絕對秒數必然越大，但佔比不會，比絕對時長更能代表真異常。\nconst CLASS_A_FEATURES = {\n    lick_pct_active:    { weight:0.30, label:'Lick % of Active Time',    threshold_mild:2.5, threshold_mod:3.0, threshold_severe:4.0, can_independently_trigger:true },\n    lick_frequency:      { weight:0.15, label:'Lick Frequency',           threshold_mild:2.5, threshold_mod:3.0, threshold_severe:4.0, can_independently_trigger:true },\n    scratch_pct_active:  { weight:0.30, label:'Scratch % of Active Time', threshold_mild:2.5, threshold_mod:3.0, threshold_severe:4.0, can_independently_trigger:true },\n    scratch_frequency:   { weight:0.10, label:'Scratch Frequency',       threshold_mild:2.5, threshold_mod:3.0, threshold_severe:4.0, can_independently_trigger:true }\n};\nconst CLASS_B_FEATURES = {\n    head_shake:        { weight:0.40, label:'Head Shake',        can_independently_trigger:false },\n    walk_duration:     { weight:0.30, label:'Walk Duration',     can_independently_trigger:false },\n    inactive_duration: { weight:0.30, label:'Inactive Duration', can_independently_trigger:false }\n};\nconst LEVEL_ORDER = ['Normal','Mild Behavioral Deviation','Moderate Behavioral Deviation','Severe Behavioral Deviation'];\n\n// Feature Metadata\nconst FEATURE_METADATA = {\n    lick_pct_active: {\n        feature_name:'Lick % of Active Time', priority_class:'Class A (Critical)',\n        scientific_meaning:'理毛「佔非睡眠/休息時間比例」過高，可能與搔癢、疼痛、壓力等相關（VAScat, 2020）；改用比例而非絕對秒數，避免監控時間長短造成誤判',\n        population_ref:'健康成貓：約 8%（Eckstein & Hart, 2000）',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'監測理毛佔活動時間比例是否偏離個體正常模式，不代表疾病診斷',\n        can_independently_trigger:true\n    },\n    scratch_pct_active: {\n        feature_name:'Scratch % of Active Time', priority_class:'Class A (Critical)',\n        scientific_meaning:'搔抓「佔非睡眠/休息時間比例」過高，可能與皮膚刺激、過敏、疼痛等相關；改用比例而非絕對秒數，避免監控時間長短造成誤判',\n        population_ref:'健康成貓：約 0.2%（Eckstein & Hart, 2000）',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'監測搔抓佔活動時間比例是否偏離個體基線，不代表過敏診斷',\n        can_independently_trigger:true\n    },\n    lick_frequency: {\n        feature_name:'Lick Frequency', priority_class:'Class A (Critical)',\n        scientific_meaning:'理毛次數增加可能反映不適感',\n        population_ref:'N/A（次數難以跨研究標準化）',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'與 Lick Duration 共同評估理毛行為偏差',\n        can_independently_trigger:true\n    },\n    scratch_frequency: {\n        feature_name:'Scratch Frequency', priority_class:'Class A (Critical)',\n        scientific_meaning:'搔抓次數可能反映皮膚刺激強度',\n        population_ref:'N/A',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'與 Scratch Duration 共同評估搔抓行為偏差',\n        can_independently_trigger:true\n    },\n    head_shake: {\n        feature_name:'Head Shake Frequency', priority_class:'Class B (Supporting)',\n        scientific_meaning:'頻繁甩頭可能與耳部不適、耳蟎、耳道感染相關',\n        population_ref:'偶爾甩頭屬正常範圍，無固定群體參考值',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'輔助評估整體偏差程度，不可獨立觸發警報',\n        can_independently_trigger:false\n    },\n    walk_duration: {\n        feature_name:'Walk Duration', priority_class:'Class B (Supporting)',\n        scientific_meaning:'行走時間代表整體活動量，減少可能代表不適',\n        population_ref:'因個體差異大，無固定群體參考值',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'輔助評估活動基線偏差',\n        can_independently_trigger:false\n    },\n    inactive_duration: {\n        feature_name:'Inactive Duration', priority_class:'Class B (Supporting)',\n        scientific_meaning:'靜止時間過長可能代表低活力或不適',\n        population_ref:'因個體差異大，無固定群體參考值',\n        individual_ref:'此貓個體基線（請見 Individual Baseline 欄位）',\n        monitoring_purpose:'輔助評估活動基線偏差',\n        can_independently_trigger:false\n    }\n};\n\n// 若基線不足\nif (!dev || !dev.computed_at) {\n    let result = {\n        behavior_deviation_score:0, behavior_status:'基線建立中', behavior_trend:'Insufficient Data',\n        behavior_deviation_level:'Insufficient Data', score:0, level:'Insufficient Data',\n        color:'#9e9e9e', emoji:'⏳',\n        components:{ class_a:0,class_b:0,class_c:0,rhythm:0,transition:0,grooming:0,activity:0,distribution:0,frequency:0 },\n        class_a_triggered:false, class_a_override:null,\n        alerts:[],\n        xai_explanation:{\n            behavior_deviation:'Insufficient Data', top_contributors:[], class_a_triggered:false,\n            interpretation:'基線資料不足，尚無法進行行為偏差分析。請持續運行系統至少 '+(bl.required_days||7)+' 天。',\n            population_reference:POPULATION_REFERENCE,\n            research_note:'本系統採用三層研究架構：Population Reference（群體文獻值）→ Individual Baseline（個體基線）→ Behavioral Deviation（行為偏差）。',\n            disclaimer:'本系統僅監測行為偏差，不代表任何疾病診斷。'\n        },\n        population_reference:POPULATION_REFERENCE, confidence:bl.confidence||'Low',\n        computed_at:new Date().toISOString()\n    };\n    global.set('v2_risk',result);\n    msg.payload.risk=result; msg.payload.user_settings=cfg;\n    msg.payload.v2_event_tags=(global.get(\"gfile\").get('v2_event_tags')||[]).slice(-14);\n    msg.payload.v2_daily_history=(global.get(\"gfile\").get('v2_daily_history')||[]).slice(-30);\n    msg.payload.v2_excluded_dates=global.get(\"gfile\").get('v2_excluded_dates')||[];\n    msg.payload.v2_insufficient=true;\n    flow.set('v2_today_risk',{level:'Insufficient Data',score:0});\n    return [msg, null];\n}\n\nfunction gz(key) { return dev[key]&&dev[key].z_score!=null?(dev[key].z_score||0):0; }\n\nlet z_lick_d = gz('lick_pct_active');\nlet z_lick_f = gz('lick_frequency');\nlet z_scr_d  = gz('scratch_pct_active');\nlet z_scr_f  = gz('scratch_frequency');\nlet z_shake  = gz('head_shake');\nlet z_walk   = gz('walk_duration');\nlet z_stop   = gz('inactive_duration');\n\n// ── Class A Score（Critical Behaviour, 0~100）──\n// 加權 Z-score 融合（4個 Class A 特徵，權重總和歸一化）\nlet classAWeightedZ = (Math.abs(z_lick_d)*0.30 + Math.abs(z_lick_f)*0.15 + Math.abs(z_scr_d)*0.30 + Math.abs(z_scr_f)*0.10) / 0.85;\nlet classAScore = Math.min(100, classAWeightedZ * 25);\n\n// ── Class A Override Rule（Single Behavior Critical Rule）──\n// 高重要性行為允許單獨觸發偏差判定，防止 False Negative\n// 例：舔舐 +4σ，其他正常 → 仍觸發 Moderate Behavioral Deviation\nlet classAOverride = null;\nlet classADetails = {\n    lick_pct_active:   { z:z_lick_d, abs_z:Math.abs(z_lick_d), triggered:false },\n    lick_frequency:    { z:z_lick_f, abs_z:Math.abs(z_lick_f), triggered:false },\n    scratch_pct_active:{ z:z_scr_d,  abs_z:Math.abs(z_scr_d),  triggered:false },\n    scratch_frequency: { z:z_scr_f,  abs_z:Math.abs(z_scr_f),  triggered:false }\n};\nlet maxClassAZ = Math.max(...Object.values(classADetails).map(d=>d.abs_z));\n\nif      (maxClassAZ >= 4.0) { classAOverride = 'Severe Behavioral Deviation';   Object.keys(classADetails).forEach(k=>{ if(classADetails[k].abs_z>=4.0) classADetails[k].triggered=true; }); }\nelse if (maxClassAZ >= 3.0) { classAOverride = 'Moderate Behavioral Deviation'; Object.keys(classADetails).forEach(k=>{ if(classADetails[k].abs_z>=3.0) classADetails[k].triggered=true; }); }\nelse if (maxClassAZ >= 2.5) { classAOverride = 'Mild Behavioral Deviation';     Object.keys(classADetails).forEach(k=>{ if(classADetails[k].abs_z>=2.5) classADetails[k].triggered=true; }); }\nlet classATriggered = classAOverride !== null;\n\n// ── Class B Score（Supporting Behaviour, 0~100）──\nlet classBWeightedZ = Math.abs(z_shake)*0.40 + Math.abs(z_walk)*0.30 + Math.abs(z_stop)*0.30;\nlet classBScore = Math.min(100, classBWeightedZ * 25);\n\n// ── Class C Score（Pattern Behaviour, 0~100）──\nlet rhythmScore=0;\nlet night=rhythm['00-06']||{}, 