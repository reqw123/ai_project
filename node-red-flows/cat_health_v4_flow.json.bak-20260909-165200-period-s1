3-dev-lbl\">{{r.ico}} {{r.lbl}}</div><div class=\"p3-dev-track\"><div class=\"p3-dev-fill\" ng-class=\"devTone(r.metric)\" ng-style=\"{width:devWidth(r.metric)+'%'}\"></div></div><div class=\"p3-dev-num\"><span class=\"p3-dev-score\" ng-style=\"{color:devColor(r.metric)}\">{{devScore(r.metric)}}</span><span class=\"p3-dev-z\">{{devZ(r.metric)}}</span></div></div>\n      </div>\n      <div class=\"p3-empty\" ng-if=\"!deviationAvailable()\">個體化基線建立後顯示偏差分析</div>\n    </section>\n\n    <section class=\"p3-section wide\">\n      <div class=\"p3-sec-head\"><div class=\"p3-sec-title\">四時段行為節律</div><div class=\"p3-sec-hint\">各時段主導行為與內部比例</div></div>\n      <div class=\"p3-rhythm-grid\">\n        <article class=\"p3-rhythm-card\" ng-repeat=\"pd in periods\">\n          <div class=\"p3-rh-period\">◷ {{pd}}</div><div class=\"p3-rh-main\"><div class=\"p3-rh-dom\">{{domEmoji(rhythmData(pd).dominant)}}</div><div><div class=\"p3-rh-name\">{{domName(rhythmData(pd).dominant)}}</div><div class=\"p3-rh-pct\">{{dominantPct(pd)}}</div></div></div>\n          <div class=\"p3-rh-mini\"><div class=\"p3-rh-mini-row\" ng-repeat=\"b in behaviors\"><div class=\"p3-rh-mini-lbl\">{{b.ico}}</div><div class=\"p3-rh-mini-bar\"><div class=\"p3-rh-mini-fill\" ng-style=\"{width:rhythmPct(pd,b.key)+'%',background:b.color}\"></div></div></div></div>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"p3-section wide\">\n      <div class=\"p3-sec-head\"><div class=\"p3-sec-title\">行為轉移矩陣</div><div class=\"p3-sec-hint\">列為前一行為，欄為下一行為；色彩越亮代表轉移越頻繁</div></div>\n      <div class=\"p3-mx-wrap\"><table class=\"p3-mx-table\"><thead><tr><th>FROM \\ TO</th><th ng-repeat=\"to in behaviors\">{{to.ico}} {{to.name}}</th></tr></thead><tbody><tr ng-repeat=\"from in behaviors\"><th>{{from.ico}} {{from.name}}</th><td ng-repeat=\"to in behaviors\"><div class=\"p3-mx-cell\" ng-style=\"{background:matrixCellColor(from.key,to.key),color:matrixTextColor(from.key,to.key)}\">{{matrixVal(from.key,to.key)}}</div></td></tr></tbody></table></div>\n    </section>\n  </div>\n</div>\n\n<script>\n(function(scope){\n  scope.behaviors=[\n    {key:'walk',name:'行走',ico:'🚶',color:'#55d6c2'},{key:'lick',name:'舔舐',ico:'😸',color:'#a78bfa'},\n    {key:'scratch',name:'搔抓',ico:'🐾',color:'#f472b6'},{key:'shake',name:'甩頭',ico:'↻',color:'#63a7ff'},{key:'stop',name:'靜止',ico:'☾',color:'#71839a'}\n  ];\n  scope.deviationRows=[\n    {metric:'lick_duration',lbl:'舔舐時間',ico:'😸'},{metric:'scratch_duration',lbl:'搔抓時間',ico:'🐾'},\n    {metric:'head_shake',lbl:'甩頭次數',ico:'↻'},{metric:'inactive_duration',lbl:'靜止時間',ico:'☾'},{metric:'walk_duration',lbl:'行走時間',ico:'🚶'}\n  ];\n  scope.periods=['00-06','06-12','12-18','18-24'];scope.rhythm={};scope.matrix={};scope.init=function(){};\n  scope.payload=function(){return scope.msg&&scope.msg.payload?scope.msg.payload:{};};scope.distPct=function(k){var d=scope.payload().distribution;return d&&d[k]!=null?Number(d[k]).toFixed(2):'0.00';};\n  scope.domEmoji=function(d){return {walk:'🚶',lick:'😸',scratch:'🐾',shake:'↻',stop:'☾',none:'—'}[d]||'—';};scope.domName=function(d){return {walk:'行走',lick:'舔舐',scratch:'搔抓',shake:'甩頭',stop:'靜止',none:'無資料'}[d]||d||'無資料';};\n  scope.rhythmData=function(pd){return scope.rhythm[pd]||{dominant:'none',pct:{},total:0};};scope.rhythmPct=function(pd,k){return Number(scope.rhythmData(pd).pct&&scope.rhythmData(pd).pct[k]||0);};scope.dominantPct=function(pd){var r=scope.rhythmData(pd),v=r.dominant!=='none'?scope.rhythmPct(pd,r.dominant):0;return r.dominant==='none'?'尚無資料':v.toFixed(2)+'%';};\n  scope.matrixVal=function(f,t){return Number(scope.matrix[f+'->'+t]||0);};scope.matrixMax=function(){var vals=Object.values(scope.matrix||{}).map(Number);return Math.max.apply(Math,vals.concat([1]));};\n  scope.matrixCellColor=function(f,t){var v=scope.matrixVal(f,t);if(!v)return 'rgba(113,131,154,.035)';var a=Math.min(.78,.1+v/scope.matrixMax()*.68);return 'rgba(99,167,255,'+a+')';};scope.matrixTextColor=function(f,t){return scope.matrixVal(f,t)/scope.matrixMax()>.55?'#06101d':'#edf6ff';};\n  scope.devRecord=function(k){var d=scope.payload().deviation;return d&&d[k]?d[k]:null;};scope.deviationAvailable=function(){return !!scope.payload().deviation_available&&!!scope.payload().deviation;};\n  scope.devScore=function(k){var r=scope.devRecord(k);return r&&r.deviation_score!=null?Number(r.deviation_score).toFixed(1):'--';};scope.devZ=function(k){var r=scope.devRecord(k);if(!r||r.z_score==null)return 'Z --';var z=Number(r.z_score);return 'Z '+(z>=0?'+':'')+z.toFixed(2)+'σ';};\n  scope.devWidth=function(k){var r=scope.devRecord(k);return r&&r.deviation_score!=null?Math.max(1,Math.min(100,Number(r.deviation_score))):0;};scope.devTone=function(k){var s=Number(scope.devScore(k));return s>=50?'high':s>=20?'attn':'';};scope.devColor=function(k){var s=Number(scope.devScore(k));return s>=50?'#fb7b84':s>=20?'#facc15':'#55d6c2';};\n  scope.$watch('msg.payload',function(p){if(!p)return;scope.rhythm=p.rhythm||{};scope.matrix=p.v2_matrix||{};});\n})(scope);\n</script>",
