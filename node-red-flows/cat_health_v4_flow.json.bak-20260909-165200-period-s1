    "format": "<style>\n  :root {\n    --ch-bg: #07111f;\n    --ch-surface: #0d1a2b;\n    --ch-surface-2: #122238;\n    --ch-line: rgba(148, 178, 210, .14);\n    --ch-text: #f4f8fc;\n    --ch-muted: #8da2b8;\n    --ch-cyan: #55d6c2;\n    --ch-blue: #63a7ff;\n    --ch-violet: #a78bfa;\n    --ch-pink: #f472b6;\n    --ch-slate: #71839a;\n    --ch-ok: #4ade80;\n    --ch-attn: #facc15;\n    --ch-warn: #fb923c;\n    --ch-high: #fb5c68;\n    --ch-shadow: 0 18px 46px rgba(0, 0, 0, .28);\n    --ch-radius: 20px;\n  }\n\n  body.nr-dashboard-theme,\n  .nr-dashboard-theme md-content {\n    background: radial-gradient(circle at 18% -10%, rgba(36, 108, 150, .18), transparent 34%), #06101d !important;\n    color: var(--ch-text)\n  }\n\n  .nr-dashboard-theme md-toolbar {\n    background: rgba(7, 17, 31, .94) !important;\n    border-bottom: 1px solid var(--ch-line);\n    box-shadow: none !important\n  }\n\n  .nr-dashboard-theme md-sidenav {\n    background: #081422 !important;\n    border-right: 1px solid var(--ch-line)\n  }\n\n  .nr-dashboard-theme ui-card-panel,\n  .nr-dashboard-theme .nr-dashboard-cardpanel {\n    background: transparent !important;\n    box-shadow: none !important;\n    border: 0 !important\n  }\n\n  .nr-dashboard-theme .nr-dashboard-cardcontainer {\n    background: transparent !important;\n    box-shadow: none !important;\n    border: 0 !important\n  }\n\n  body.nr-dashboard-theme md-content md-card.nr-dashboard-template,\n  .nr-dashboard-theme .nr-dashboard-template {\n    background: transparent !important;\n    box-shadow: none !important;\n    border: 0 !important;\n    padding: 0 !important\n  }\n\n  .nr-dashboard-theme .nr-dashboard-cardtitle {\n    color: #90a5ba !important;\n    font-weight: 700 !important;\n    letter-spacing: .08em !important;\n    text-transform: uppercase;\n    font-size: 11px !important\n  }\n\n  .p1-wrap,\n  .p1-wrap * {\n    box-sizing: border-box\n  }\n\n  .p1-wrap {\n    font-family: Inter, \"Noto Sans TC\", \"Microsoft JhengHei\", sans-serif;\n    color: var(--ch-text);\n    padding: clamp(12px, 2vw, 22px);\n    background: linear-gradient(145deg, rgba(11, 27, 45, .96), rgba(6, 16, 29, .98));\n    border: 1px solid var(--ch-line);\n    border-radius: var(--ch-radius);\n    box-shadow: var(--ch-shadow);\n    position: relative;\n    overflow: hidden;\n    isolation: isolate\n  }\n\n  .p1-wrap:before {\n    content: \"\";\n    position: absolute;\n    width: 360px;\n    height: 360px;\n    border-radius: 50%;\n    right: -170px;\n    top: -210px;\n    background: radial-gradient(circle, rgba(85, 214, 194, .16), transparent 66%);\n    z-index: -1;\n    pointer-events: none\n  }\n\n  .p1-app-head {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 14px;\n    padding: 0 2px 14px;\n    border-bottom: 1px solid var(--ch-line);\n    margin-bottom: 16px\n  }\n\n  .p1-brand {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    min-width: 0\n  }\n\n  .p1-brand-mark {\n    width: 40px;\n    height: 40px;\n    display: grid;\n    place-items: center;\n    border-radius: 12px;\n    background: linear-gradient(145deg, rgba(85, 214, 194, .24), rgba(99, 167, 255, .12));\n    border: 1px solid rgba(85, 214, 194, .28);\n    font-size: 20px;\n    box-shadow: 0 0 20px rgba(85, 214, 194, .08)\n  }\n\n  .p1-title {\n    font-size: 17px;\n    font-weight: 850;\n    letter-spacing: .02em\n  }\n\n  .p1-subtitle {\n    font-size: 11px;\n    color: var(--ch-muted);\n    margin-top: 2px\n  }\n\n  .p1-live {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    border: 1px solid var(--ch-line);\n    border-radius: 999px;\n    padding: 6px 12px;\n    color: #b8c8d8;\n    background: rgba(255, 255, 255, .035);\n    font-size: 11px;\n    font-weight: 700;\n    white-space: nowrap\n  }\n\n  .p1-live-dot {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    background: var(--ch-ok);\n    box-shadow: 0 0 0 0 rgba(74, 222, 128, .45);\n    animation: p1-live 2s infinite\n  }\n\n  .p1-live.is-stale .p1-live-dot {\n    background: var(--ch-warn);\n    animation: none\n  }\n\n  .p1-live.is-waiting .p1-live-dot {\n    background: var(--ch-slate);\n    animation: none\n  }\n\n  .p1-hero-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.35fr) minmax(260px, .85fr);\n    gap: 14px\n  }\n\n  .p1-card {\n    background: linear-gradient(145deg, rgba(18, 34, 56, .88), rgba(10, 24, 41, .88));\n    border: 1px solid var(--ch-line);\n    border-radius: 16px;\n    padding: clamp(14px, 1.8vw, 20px);\n    position: relative;\n    overflow: hidden\n  }\n\n  .p1-eyebrow {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 10px;\n    color: var(--ch-muted);\n    text-transform: uppercase;\n    letter-spacing: .12em;\n    font-weight: 800\n  }\n\n  .p1-current-main {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    margin: 16px 0\n  }\n\n  .p1-emoji {\n    width: 66px;\n    height: 66px;\n    flex: 0 0 66px;\n    display: grid;\n    place-items: center;\n    border-radius: 18px;\n    font-size: 34px;\n    background: linear-gradient(145deg, rgba(85, 214, 194, .2), rgba(99, 167, 255, .1));\n    border: 1px solid rgba(85, 214, 194, .24);\n    box-shadow: inset 0 1px rgba(255, 255, 255, .07), 0 8px 24px rgba(0, 0, 0, .18)\n  }\n\n  .p1-emoji.is-changing {\n    animation: p1-pop .48s cubic-bezier(.2, .8, .2, 1)\n  }\n\n  .p1-behavior {\n    font-size: clamp(24px, 3.5vw, 34px);\n    font-weight: 900;\n    line-height: 1.05;\n    letter-spacing: -.025em\n  }\n\n  .p1-time {\n    font-size: 11px;\n    color: var(--ch-muted);\n    margin-top: 6px\n  }\n\n  .p1-score-row {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 9px\n  }\n\n  .p1-score-box {\n    background: rgba(255, 255, 255, .03);\n    border: 1px solid rgba(255, 255, 255, .06);\n    border-radius: 12px;\n    padding: 11px 13px\n  }\n\n  .p1-score-val {\n    font-size: 22px;\n    font-weight: 900;\n    letter-spacing: -.03em\n  }\n\n  .p1-score-lbl {\n    font-size: 10px;\n    color: var(--ch-muted);\n    margin-top: 3px\n  }\n\n  .p1-risk-card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    justify-content: center;\n    min-height: 260px;\n    transition: border-color .35s, box-shadow .35s\n  }\n\n  .p1-ring {\n    width: 130px;\n    height: 130px;\n    border-radius: 50%;\n    padding: 9px;\n    display: grid;\n    place-items: center;\n    transition: background .6s ease;\n    filter: drop-shadow(0 0 16px rgba(85, 214, 194, .1))\n  }\n\n  .p1-ring-inner {\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    background: #0b1929;\n    border: 1px solid rgba(255, 255, 255, .08);\n    box-shadow: inset 0 0 24px rgba(0, 0, 0, .28)\n  }\n\n  .p1-ring-score {\n    font-size: 36px;\n    font-weight: 950;\n    line-height: 1;\n    letter-spacing: -.05em\n  }\n\n  .p1-ring-unit {\n    font-size: 9px;\n    color: var(--ch-muted);\n    margin-top: 4px;\n    letter-spacing: .1em\n  }\n\n  .p1-risk-badge {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    margin-top: 11px;\n    padding: 5px 12px;\n    border-radius: 999px;\n    font-size: 11.5px;\n    font-weight: 850;\n    border: 1px solid transparent\n  }\n\n  .risk-normal {\n    color: #86efac;\n    background: rgba(74, 222, 128, .1);\n    border-color: rgba(74, 222, 128, .25)\n  }\n\n  .risk-attention {\n    color: #fde047;\n    background: rgba(250, 204, 21, .1);\n    border-color: rgba(250, 204, 21, .25)\n  }\n\n  .risk-warning {\n    color: #fdba74;\n    background: rgba(251, 146, 60, .1);\n    border-color: rgba(251, 146, 60, .28)\n  }\n\n  .risk-high {\n    color: #fda4af;\n    background: rgba(251, 92, 104, .11);\n    border-color: rgba(251, 92, 104, .32)\n  }\n\n  .p1-risk-card.risk-high {\n    box-shadow: inset 0 0 0 1px rgba(251, 92, 104, .12), 0 0 28px rgba(251, 92, 104, .08);\n    animation: p1-critical 2.2s ease-in-out infinite\n  }\n\n  .p1-components {\n    width: 100%;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 5px;\n    margin-top: 12px\n  }\n\n  .p1-component {\n    padding: 7px 4px;\n    border-radius: 9px;\n    background: rgba(255, 255, 255, .035);\n    font-size: 8.5px;\n    color: var(--ch-muted)\n  }\n\n  .p1-component strong {\n    display: block;\n    color: var(--ch-text);\n    font-size: 13px;\n    margin-bottom: 2px\n  }\n\n  /* 下半部網格優化 */\n  .p1-lower-grid {\n    display: grid;\n    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 1fr);\n    gap: 14px;\n    margin-top: 14px\n  }\n\n  .p1-panel {\n    background: rgba(10, 24, 41, .66);\n    border: 1px solid var(--ch-line);\n    border-radius: 16px;\n    padding: 15px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between\n  }\n\n  .p1-section-head {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 8px;\n    margin-bottom: 12px\n  }\n\n  .p1-section-title {\n    font-size: 12.5px;\n    font-weight: 850;\n    letter-spacing: .02em\n  }\n\n  .p1-section-hint {\n    font-size: 10px;\n    color: var(--ch-muted)\n  }\n\n  .p1-bars {\n    display: grid;\n    gap: 9px\n  }\n\n  .p1-bar-row {\n    display: grid;\n    grid-template-columns: 64px minmax(0, 1fr) 44px;\n    align-items: center;\n    gap: 8px\n  }\n\n  .p1-bar-lbl {\n    font-size: 10.5px;\n    color: #c6d3df;\n    font-weight: 650\n  }\n\n  .p1-bar-track {\n    height: 8px;\n    background: rgba(142, 163, 184, .11);\n    border-radius: 999px;\n    overflow: hidden\n  }\n\n  .p1-bar-fill {\n    height: 100%;\n    border-radius: 999px;\n    transition: width .65s cubic-bezier(.2, .8, .2, 1);\n    box-shadow: 0 0 10px currentColor\n  }\n\n  .fill-walk {\n    background: linear-gradient(90deg, #2abda8, #55d6c2)\n  }\n\n  .fill-lick {\n    background: linear-gradient(90deg, #8568dc, #a78bfa)\n  }\n\n  .fill-scratch {\n    background: linear-gradient(90deg, #db559d, #f472b6)\n  }\n\n  .fill-shake {\n    background: linear-gradient(90deg, #438ce8, #63a7ff)\n  }\n\n  .fill-stop {\n    background: linear-gradient(90deg, #566b82, #71839a)\n  }\n\n  .p1-bar-val {\n    font-size: 10.5px;\n    color: #dce6ef;\n    text-align: right;\n    font-variant-numeric: tabular-nums\n  }\n\n  /* 控制區域防擠壓與精緻化 */\n  .p1-actions {\n    gap: 10px\n  }\n\n  .p1-stream-btn {\n    width: 100%;\n    border: 1px solid rgba(99, 167, 255, .36);\n    color: #a9ceff;\n    background: linear-gradient(135deg, rgba(99, 167, 255, .18), rgba(85, 214, 194, .09));\n    border-radius: 10px;\n    padding: 9px 12px;\n    font-size: 11.5px;\n    font-weight: 750;\n    cursor: pointer;\n    font-family: inherit;\n    transition: transform .16s, background .16s, border-color .16s, box-shadow .16s;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px\n  }\n\n  .p1-stream-btn:hover {\n    transform: translateY(-1px);\n    background: rgba(99, 167, 255, .24);\n    border-color: rgba(99, 167, 255, .55);\n    box-shadow: 0 4px 14px rgba(99, 167, 255, .12)\n  }\n\n  .p1-stream-btn:active {\n    transform: scale(.98)\n  }\n\n  .p1-overlay-box {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n    margin-top: 2px\n  }\n\n  .p1-overlay-title {\n    font-size: 9.5px;\n    color: var(--ch-muted);\n    letter-spacing: .09em;\n    text-transform: uppercase;\n    font-weight: 750\n  }\n\n  .p1-overlay-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 6px;\n    width: 100%\n  }\n\n  .p1-ov-btn {\n    min-height: 34px;\n    border-radius: 9px;\n    padding: 6px 8px;\n    font-size: 11px;\n    cursor: pointer;\n    font-family: inherit;\n    font-weight: 700;\n    transition: all .18s;\n    border: 1px solid;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis\n  }\n\n  .p1-ov-btn:active {\n    transform: scale(.97)\n  }\n\n  .p1-ov-on {\n    background: rgba(85, 214, 194, .12);\n    border-color: rgba(85, 214, 194, .38);\n    color: #8ee7da;\n    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .06)\n  }\n\n  .p1-ov-off {\n    background: rgba(255, 255, 255, .02);\n    border-color: var(--ch-line);\n    color: #6b7f94\n  }\n\n  .p1-ov-off:hover {\n    border-color: rgba(148, 178, 210, .25);\n    background: rgba(255, 255, 255, .04);\n    color: #92a6bb\n  }\n\n  @keyframes p1-live {\n    70% {\n      box-shadow: 0 0 0 6px rgba(74, 222, 128, 0)\n    }\n  }\n\n  @keyframes p1-pop {\n    0% {\n      transform: scale(.88);\n      filter: brightness(1.8)\n    }\n\n    60% {\n      transform: scale(1.08)\n    }\n\n    100% {\n      transform: scale(1)\n    }\n  }\n\n  @keyframes p1-critical {\n    50% {\n      border-color: rgba(251, 92, 104, .48);\n      box-shadow: 0 0 28px rgba(251, 92, 104, .14)\n    }\n  }\n\n  @media(max-width:900px) {\n\n    .p1-hero-grid,\n    .p1-lower-grid {\n      grid-template-columns: 1fr\n    }\n\n    .p1-risk-card {\n      min-height: unset\n    }\n\n    .p1-ring {\n      width: 120px;\n      height: 120px\n    }\n\n    .p1-components {\n      max-width: 360px\n    }\n  }\n\n  @media(max-width:560px) {\n    .p1-wrap {\n      border-radius: 15px;\n      padding: 12px\n    }\n\n    .p1-app-head {\n      align-items: center\n    }\n\n    .p1-title {\n      font-size: 15px\n    }\n\n    .p1-subtitle {\n      display: none\n    }\n\n    .p1-live {\n      padding: 5px 8px;\n      font-size: 10px\n    }\n\n    .p1-card,\n    .p1-panel {\n      border-radius: 14px;\n      padding: 12px\n    }\n\n    .p1-current-main {\n      gap: 12px;\n      margin: 12px 0\n    }\n\n    .p1-emoji {\n      width: 54px;\n      height: 54px;\n      flex-basis: 54px;\n      border-radius: 15px;\n      font-size: 28px\n    }\n\n    .p1-behavior {\n      font-size: 24px\n    }\n\n    .p1-score-row {\n      gap: 6px\n    }\n\n    .p1-score-val {\n      font-size: 19px\n    }\n\n    .p1-bar-row {\n      grid-template-columns: 56px 1fr 38px;\n      gap: 6px\n    }\n\n    .p1-ov-btn {\n      font-size: 10px;\n      min-height: 32px\n    }\n  }\n\n  @media(prefers-reduced-motion:reduce) {\n    .p1-wrap * {\n      animation: none !important;\n      transition: none !important\n    }\n  }\n</style>\n\n<div class=\"p1-wrap\" ng-init=\"init()\">\n  <header class=\"p1-app-head\">\n    <div class=\"p1-brand\">\n      <div class=\"p1-brand-mark\">🐱</div>\n      <div>\n        <div class=\"p1-title\">Cat Health Intelligence</div>\n        <div class=\"p1-subtitle\">個體化行為健康監測中心</div>\n      </div>\n    </div>\n    <div class=\"p1-live\" ng-class=\"{'is-stale':connectionState==='stale','is-waiting':connectionState==='waiting'}\">\n      <span class=\"p1-live-dot\"></span>{{connectionText()}}\n    </div>\n  </header>\n\n  <section class=\"p1-hero-grid\">\n    <article class=\"p1-card p1-current-card\">\n      <div class=\"p1-eyebrow\">● Live behavior · 即時行為</div>\n      <div class=\"p1-current-main\">\n        <div class=\"p1-emoji\" ng-class=\"{'is-changing':behaviorPulse}\">{{cur.emoji || '🐱'}}</div>\n        <div>\n          <div class=\"p1-behavior\">{{behaviorName(cur.behavior)}}</div>\n          <div class=\"p1-time\">最後辨識 · {{cur.timestamp || lastSeenText()}}</div>\n        </div>\n      </div>\n      <div class=\"p1-score-row\">\n        <div class=\"p1-score-box\">\n          <div class=\"p1-score-val\">{{activityScore()}}</div>\n          <div class=\"p1-score-lbl\">活動力指數</div>\n        </div>\n        <div class=\"p1-score-box\">\n          <div class=\"p1-score-val\">{{riskScore()}}</div>\n          <div class=\"p1-score-lbl\">綜合偏差分</div>\n        </div>\n      </div>\n    </article>\n\n    <article class=\"p1-card p1-risk-card\" ng-class=\"riskCls\">\n      <div class=\"p1-eyebrow\">Behavior risk · 行為風險</div>\n      <div class=\"p1-ring\" ng-style=\"riskRingStyle()\">\n        <div class=\"p1-ring-inner\">\n          <div class=\"p1-ring-score\">{{riskScore()}}</div>\n          <div class=\"p1-ring-unit\">/ 100</div>\n        </div>\n      </div>\n      <div class=\"p1-risk-badge\" ng-class=\"riskCls\">{{risk.emoji || '⏳'}} {{riskLevelZh(risk.level)}}</div>\n      <div class=\"p1-components\">\n        <div class=\"p1-component\"><strong>{{riskComponent('class_a')}}</strong>關鍵行為</div>\n        <div class=\"p1-component\"><strong>{{riskComponent('class_b')}}</strong>輔助行為</div>\n        <div class=\"p1-component\"><strong>{{riskComponent('class_c')}}</strong>行為模式</div>\n      </div>\n    </article>\n  </section>\n\n  <section class=\"p1-lower-grid\">\n    <div class=\"p1-panel\">\n      <div class=\"p1-section-head\">\n        <div class=\"p1-section-title\">今日行為組成</div>\n        <div class=\"p1-section-hint\">依辨識累積時間</div>\n      </div>\n      <div class=\"p1-bars\">\n        <div class=\"p1-bar-row\">\n          <div class=\"p1-bar-lbl\">🚶 行走</div>\n          <div class=\"p1-bar-track\">\n            <div class=\"p1-bar-fill fill-walk\" ng-style=\"{width:pct('walk')+'%'}\"></div>\n          </div>\n          <div class=\"p1-bar-val\">{{pct('walk')}}%</div>\n        </div>\n        <div class=\"p1-bar-row\">\n          <div class=\"p1-bar-lbl\">😸 舔舐</div>\n          <div class=\"p1-bar-track\">\n            <div class=\"p1-bar-fill fill-lick\" ng-style=\"{width:pct('lick')+'%'}\"></div>\n          </div>\n          <div class=\"p1-bar-val\">{{pct('lick')}}%</div>\n        </div>\n        <div class=\"p1-bar-row\">\n          <div class=\"p1-bar-lbl\">🐾 搔抓</div>\n          <div class=\"p1-bar-track\">\n            <div class=\"p1-bar-fill fill-scratch\" ng-style=\"{width:pct('scratch')+'%'}\"></div>\n          </div>\n          <div class=\"p1-bar-val\">{{pct('scratch')}}%</div>\n        </div>\n        <div class=\"p1-bar-row\">\n          <div class=\"p1-bar-lbl\">↻ 甩頭</div>\n          <div class=\"p1-bar-track\">\n            <div class=\"p1-bar-fill fill-shake\" ng-style=\"{width:pct('shake')+'%'}\"></div>\n          </div>\n          <div class=\"p1-bar-val\">{{pct('shake')}}%</div>\n        </div>\n        <div class=\"p1-bar-row\">\n          <div class=\"p1-bar-lbl\">☾ 靜止</div>\n          <div class=\"p1-bar-track\">\n            <div class=\"p1-bar-fill fill-stop\" ng-style=\"{width:pct('stop')+'%'}\"></div>\n          </div>\n          <div class=\"p1-bar-val\">{{pct('stop')}}%</div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"p1-panel p1-actions\">\n      <div class=\"p1-section-head\">\n        <div class=\"p1-section-title\">影像控制</div>\n        <div class=\"p1-section-hint\">Python Overlay</div>\n      </div>\n      <button onclick=\"if(window.gfvToggle){window.gfvToggle();}else{alert('請確認已載入貓咪主控流程');}\" class=\"gfv-p1-stream-btn p1-stream-btn\">▣ 開啟即時串流影像</button>\n\n      <div class=\"p1-overlay-box\">\n        <div class=\"p1-overlay-title\">圖層開關 (Overlay Layers)</div>\n        <div class=\"p1-overlay-grid\">\n          <button ng-click=\"overlayToggle('master')\" class=\"p1-ov-btn\" ng-class=\"overlayState.master?'p1-ov-on':'p1-ov-off'\">{{overlayState.master ? '全部關閉' : '全部開啟'}}</button>\n          <button ng-click=\"overlayToggle('skeleton')\" class=\"p1-ov-btn\" ng-class=\"overlayState.skeleton?'p1-ov-on':'p1-ov-off'\">骨架</button>\n          <button ng-click=\"overlayToggle('label')\" class=\"p1-ov-btn\" ng-class=\"overlayState.label?'p1-ov-on':'p1-ov-off'\">行為標籤</button>\n          <button ng-click=\"overlayToggle('bbox')\" class=\"p1-ov-btn\" ng-class=\"overlayState.bbox?'p1-ov-on':'p1-ov-off'\">偵測框</button>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n\n<script>\n  (function(scope){\n  scope.cur={};scope.risk={};scope.riskCls='risk-normal';scope.pythonIp='127.0.0.1';scope.overlayState={master:true,skeleton:true,label:true,bbox:true};\n  scope.connectionState='waiting';scope.lastSeen=null;scope.behaviorPulse=false;\n  var staleTimer=null,previousBehavior=null;\n  scope.init=function(){};\n  scope.payload=function(){return scope.msg&&scope.msg.payload?scope.msg.payload:{};};\n  scope.overlayToggle=function(key){\n    var url='http://'+scope.pythonIp+':5000/api/overlay';\n    fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key:key,action:'toggle'})})\n      .then(function(r){return r.json();}).then(function(d){if(d.state)scope.$evalAsync(function(){scope.overlayState=d.state;});}).catch(function(){});\n  };\n  scope.riskLevelZh=function(lvl){return (lvl==='Severe Behavioral Deviation'||lvl==='High Risk')?'重度行為偏差':(lvl==='Moderate Behavioral Deviation'||lvl==='Warning')?'中度行為偏差':(lvl==='Mild Behavioral Deviation'||lvl==='Attention')?'輕度行為偏差':lvl==='Normal'?'行為正常':lvl||'基線計算中';};\n  scope.behaviorName=function(b){return {walk:'行走',lick:'舔舐',scratch:'搔抓',shake:'甩頭',stop:'靜止',not:'不在畫面'}[b]||b||'等待辨識';};\n  scope.riskScore=function(){var v=Number(scope.risk.score);return isFinite(v)?Math.max(0,Math.min(100,Math.round(v))):0;};\n  scope.activityScore=function(){var v=Number(scope.payload().activity_score);return isFinite(v)?Math.round(v):0;};\n  scope.riskColor=function(){var lvl=scope.risk.level||'';return (lvl==='Severe Behavioral Deviation'||lvl==='High Risk')?'#fb5c68':(lvl==='Moderate Behavioral Deviation'||lvl==='Warning')?'#fb923c':(lvl==='Mild Behavioral Deviation'||lvl==='Attention')?'#facc15':'#4ade80';};\n  scope.riskRingStyle=function(){var score=scope.riskScore(),deg=score*3.6;return {background:'conic-gradient('+scope.riskColor()+' 0deg '+deg+'deg,rgba(142,163,184,.12) '+deg+'deg 360deg)'};};\n  scope.riskComponent=function(k){var c=scope.risk&&scope.risk.components;return c&&c[k]!=null?Math.round(c[k]):0;};\n  scope.pct=function(b){var td=scope.payload().v2_today;if(!td)return '0.00';var total=['walk','lick','scratch','shake','stop'].reduce(function(s,k){return s+Number(td[k]&&td[k].time||0);},0);if(!total)return '0.00';return (Number(td[b]&&td[b].time||0)/total*100).toFixed(2);};\n  scope.connectionText=function(){return scope.connectionState==='live'?'即時連線':scope.connectionState==='stale'?'資料暫停':'等待資料';};\n  scope.lastSeenText=function(){return scope.lastSeen?scope.lastSeen.toLocaleTimeString('zh-TW',{hour12:false}):'--:--:--';};\n  scope.$watch('msg',function(m){\n    if(!m||!m.payload)return;\n    scope.cur=m.payload.current||{};scope.risk=m.payload.risk||{};scope.lastSeen=new Date();scope.connectionState='live';\n    if(m.payload.system&&m.payload.system.ip)scope.pythonIp=m.payload.system.ip;\n    var lvl=scope.risk.level||'';\n    scope.riskCls=(lvl==='Severe Behavioral Deviation'||lvl==='High Risk')?'risk-high':(lvl==='Moderate Behavioral Deviation'||lvl==='Warning')?'risk-warning':(lvl==='Mild Behavioral Deviation'||lvl==='Attention')?'risk-attention':'risk-normal';\n    if(previousBehavior!==null&&previousBehavior!==scope.cur.behavior){scope.behaviorPulse=true;setTimeout(function(){scope.$evalAsync(function(){scope.behaviorPulse=false;});},520);}previousBehavior=scope.cur.behavior;\n    if(staleTimer)clearTimeout(staleTimer);staleTimer=setTimeout(function(){scope.$evalAsync(function(){scope.connectionState='stale';});},12000);\n  });\n  scope.$on('$destroy',function(){if(staleTimer)clearTimeout(staleTimer);});\n})(scope);\n</script>",
