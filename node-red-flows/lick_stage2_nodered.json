        "height": "3",
        "format": "<style>\n.extsrc-w{font-family:'Microsoft JhengHei',sans-serif;display:flex;align-items:center;gap:10px;padding:10px 14px;background:#0d1117;border-radius:12px;color:#fff;height:100%;box-sizing:border-box}}\n.extsrc-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}}\n.extsrc-lbl{font-size:11px;color:rgba(255,255,255,.5);font-weight:600}}\n.extsrc-val{font-size:15px;font-weight:800}\n.extsrc-age{font-size:11px;color:rgba(255,255,255,.35)}\n</style>\n<div class='extsrc-w'>\n  <div class='extsrc-dot' id='extsrc_dot' style='background:#555'></div>\n  <div>\n    <div class='extsrc-lbl'>7區域分析資料來源</div>\n    <div class='extsrc-val' id='extsrc_val'>—</div>\n    <div class='extsrc-age' id='extsrc_age'></div>\n  </div>\n</div>\n<script>\n(function(scope){\n  var COLOR={ONLINE:'#00ff88',STALE:'#f5a623',OFFLINE:'#e53935'};\n  var LABEL={ONLINE:'線上',STALE:'資料延遲',OFFLINE:'離線'};\n  scope.$watch('msg', function(msg){\n    if(!msg||!msg.payload) return;\n    var d=msg.payload;\n    var dot=document.getElementById('extsrc_dot');\n    var val=document.getElementById('extsrc_val');\n    var age=document.getElementById('extsrc_age');\n    var c=COLOR[d.status]||'#555';\n    if(dot){dot.style.background=c;dot.style.boxShadow='0 0 6px '+c;}\n    if(val){val.textContent=(LABEL[d.status]||d.status||'—');val.style.color=c;}\n    if(age){age.textContent=(d.age_sec!=null)?('上次收到資料：'+d.age_sec+'s 前'):'尚未收到過資料';}\n  });\n})(scope);\n</script>",
