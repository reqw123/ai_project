        "type": "function",
        "z": "741ff6e2a00d7d0f",
        "name": "判定 ONLINE/STALE/OFFLINE（lick_stage）",
        "func": "// M3：資料來源新鮮度判定（ONLINE/STALE/OFFLINE）。\n// 跟第一版最大差異：改成 plain function + inject，不用 subflow\n// （見本檔案開頭說明，subflow 版本造成 Node-RED 執行期當掉）。\nconst KEY = 'lick_stage';\nconst STALE_SEC = 5;\nconst OFFLINE_SEC = 30;\n\nfunction computeStatus(ageSec) {\n    if (ageSec === null || ageSec === undefined) return 'OFFLINE';\n    if (ageSec <= STALE_SEC) return 'ONLINE';\n    if (ageSec <= OFFLINE_SEC) return 'STALE';\n    return 'OFFLINE';\n}\n\nif (msg.topic === '__tick__') {\n    const lastTs = global.get(KEY + '_last_ts') || null;\n    const ageSec = lastTs !== null ? (Date.now() - lastTs) / 1000 : null;\n    const status = computeStatus(ageSec);\n    global.set(KEY + '_status', status);\n    return [null, {\n        payload: {\n            source: KEY,\n            status: status,\n            age_sec: ageSec !== null ? Math.round(ageSec * 10) / 10 : null,\n            last_ts: lastTs\n        }\n    }];\n}\n\nconst now = Date.now();\nglobal.set(KEY + '_last_ts', now);\nglobal.set(KEY + '_status', 'ONLINE');\nreturn [null, null];\n",
