    {
        "id": "f21391b1bedc8eb7",
        "type": "function",
        "z": "3db78eedd7f47c95",
        "name": "驗證 payload schema",
        "func": "// M3：先驗證再回應。核對 plugins/lick_stage/ext_body_zones/models.py::ExtZoneResult.to_payload() 的核心欄位。\n// 只驗證下游實際依賴的核心欄位，不逐一鏡射 Python dataclass 每個\n// 欄位（維護成本不成比例）；核心欄位缺失或型別不對，代表上游送壞\n// 資料或版本不相容，值得直接拒絕（400），其餘擴充欄位不檢查。\nconst SCHEMA = {\n    schema_version:  { type: 'string',  required: true },\n    session_id:      { type: 'string',  required: true },\n    current_zone:    { type: 'number',  required: true },\n    zone_name:       { type: 'string',  required: true },\n    confidence:      { type: 'number',  required: false },\n    frame_state:     { type: 'string',  required: true },\n    valid:           { type: 'boolean', required: true },\n    frame:           { type: 'number',  required: true },\n    time_sec:        { type: 'number',  required: true },\n    zones:           { type: 'object',  required: true },\n    observed_sec:    { type: 'number',  required: true },\n    stgcn_lick_sec:  { type: 'number',  required: true }\n};\n\nfunction validateShape(payload) {\n    if (payload === null || typeof payload !== 'object' || Array.isArray(payload)) {\n        return ['payload 必須是 JSON object'];\n    }\n    const errors = [];\n    for (const key of Object.keys(SCHEMA)) {\n        const rule = SCHEMA[key];\n        if (!(key in payload)) {\n            if (rule.required) errors.push('缺少必要欄位：' + key);\n            continue;\n        }\n        const v = payload[key];\n        if (v === null) continue;\n        if (typeof v !== rule.type) {\n            errors.push('欄位 ' + key + ' 型別錯誤：預期 ' + rule.type + '，實際 ' + typeof v);\n        }\n    }\n    return errors;\n}\n\nconst errors = validateShape(msg.payload);\nif (errors.length > 0) {\n    node.warn('Schema 驗證失敗：' + errors.join('; '));\n    // 重要：不能建立新物件回傳（例如 {statusCode, payload}）——那樣會\n    // 弄丟 http-in 附在原始 msg 上的 req/res 內部關聯，讓對應的\n    // http response node收不到請求脈絡、永遠回不了應（實測會讓\n    // client 端整個 hang 到逾時，不是回 400）。必須直接改動同一個\n    // msg 物件的欄位。\n    msg.statusCode = 400;\n    msg.payload = { error: 'schema_validation_failed', details: errors };\n    return [null, msg];\n}\nreturn [msg, null];\n",
