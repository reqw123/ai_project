        "name": "舔舐部位分析器",
        "func": "let d = msg.payload;\nif (!d) return [null, null, null];\n\n// 各區時長／次數：直接讀取 Python 端（plugins/lick_stage/models.py）算好的數值。\n// 佔比％（xxx_pct、best_pct）也已在 Python 端算好，Node-RED 這裡只負責組裝成\n// Dashboard 要的資料結構，不重複做除法／加總（運算模組化：Python 算，Node 顯示）。\nlet times = {\n    BODY: parseFloat(d.body_time || 0),\n    FL:   parseFloat(d.fl_time   || 0),\n    FR:   parseFloat(d.fr_time   || 0),\n    HL:   parseFloat(d.hl_time   || 0),\n    HR:   parseFloat(d.hr_time   || 0)\n};\nlet hits = {\n    BODY: parseInt(d.body_hits || 0),\n    FL:   parseInt(d.fl_hits   || 0),\n    FR:   parseInt(d.fr_hits   || 0),\n    HL:   parseInt(d.hl_hits   || 0),\n    HR:   parseInt(d.hr_hits   || 0)\n};\nlet pcts = {\n    BODY: (d.body_pct != null) ? parseFloat(d.body_pct) : NaN,\n    FL:   (d.fl_pct   != null) ? parseFloat(d.fl_pct)   : NaN,\n    FR:   (d.fr_pct   != null) ? parseFloat(d.fr_pct)   : NaN,\n    HL:   (d.hl_pct   != null) ? parseFloat(d.hl_pct)   : NaN,\n    HR:   (d.hr_pct   != null) ? parseFloat(d.hr_pct)   : NaN\n};\n\nlet zones = {};\n['BODY','FL','FR','HL','HR'].forEach(function(k){\n    let t=times[k], h=hits[k];\n    zones[k]={\n        hits:        h,\n        time_sec:    t,\n        pref_pct:    pcts[k],\n        sec_per_hit: h>0 ? t/h : NaN\n    };\n});\n\n// best_zone／best_pct 皆由 Python 端算好並送出，Node 端直接讀取，不重算\nlet best_zone = d.best_zone || 'NO_TARGET';\nlet best_pct  = (d.best_pct != null) ? parseFloat(d.best_pct) : null;\n\nfunction nf(v){return (v!=null&&v!==undefined)?parseFloat(v):NaN;}\n\nlet out = {\n    zones,\n    best_zone,\n    best_pct,\n    total_lick_time:    nf(d.total_lick_time),\n    current_zone:       d.current_zone  || 'NO_TARGET',\n    nearest_label:      d.current_zone  || 'NO_TARGET',\n    nearest_t:          NaN,\n    nose_detected:      d.valid ? 1 : 0,\n    face_state:         d.face_state    || 'UNKNOWN',\n    state_stability:    nf(d.state_stability),\n    distance_px:        nf(d.dist_px),\n    distance_norm:      nf(d.dist_norm),\n    gaze_forward_norm:  nf(d.gaze_fwd),\n    gaze_lateral_norm:  nf(d.gaze_lat),\n    gaze_angle_deg:     nf(d.gaze_angle),\n    lick_axis_score:    NaN,\n    lick_lateral_score: NaN,\n    valid:              d.valid ? 1 : 0,\n    frame:              parseInt(d.frame    || 0),\n    time_sec:           nf(d.time_sec),\n    video_path:         '',\n    trap_pts:           d.trap_pts || [],\n    nose_xy:            d.nose_xy || []\n};\n\nglobal.set('lick_s2_latest', out);\nmsg.payload = out;\nreturn [msg, msg, msg];",
