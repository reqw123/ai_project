        "id": "87b84d1b59f129a3",
        "type": "ui_template",
        "z": "3db78eedd7f47c95",
        "group": "489da40a926f4790",
        "name": "7區域統計面板",
        "order": 2,
        "width": "0",
        "height": "14",
        "format": "<style>\n.eb{font-family:'Microsoft JhengHei',sans-serif;padding:12px 14px;background:#0d1117;border-radius:14px;color:#fff;height:100%;box-sizing:border-box;display:flex;flex-direction:column;overflow:auto}\n.eb-title{font-size:11px;font-weight:700;color:rgba(255,255,255,.45);margin-bottom:10px;padding-bottom:7px;border-bottom:1px solid rgba(255,255,255,.08);letter-spacing:.6px}\n.eb-now{display:flex;align-items:center;gap:10px;padding:8px 14px;border-radius:10px;margin-bottom:10px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.12)}\n.eb-now-lbl{font-size:11px;color:rgba(255,255,255,.5);font-weight:600}\n.eb-now-zone{font-size:20px;font-weight:900;letter-spacing:-.5px}\n.eb-now-conf{font-size:12px;color:rgba(255,255,255,.5)}\n.eb-best{display:flex;align-items:center;gap:10px;padding:8px 14px;background:rgba(249,168,37,.1);border:1px solid rgba(249,168,37,.3);border-radius:10px;margin-bottom:12px}\n.eb-best-lbl{font-size:11px;color:rgba(249,168,37,.75);font-weight:600}\n.eb-best-zone{font-size:20px;font-weight:900;color:#ffd54f;letter-spacing:-.5px}\n.eb-best-pct{font-size:13px;color:rgba(255,255,255,.5)}\n.eb-tbl{width:100%;border-collapse:collapse}\n.eb-tbl th{padding:14px 16px;font-size:11px;font-weight:700;color:rgba(255,255,255,.4);background:rgba(255,255,255,.05);text-align:right;border:1px solid rgba(255,255,255,.06)}\n.eb-tbl th:first-child{text-align:left}\n.eb-tbl td{padding:16px 16px;border:1px solid rgba(255,255,255,.05);text-align:right;vertical-align:middle;font-size:14px}\n.eb-tbl td:first-child{text-align:left;font-size:15px;font-weight:600}\n.eb-dot{width:11px;height:11px;border-radius:50%;display:inline-block;margin-right:8px;vertical-align:middle}\n.td-time{font-weight:900;color:#ffe082;font-size:16px}\n.td-pct{font-weight:900;color:#80cbc4;font-size:18px}\n.td-ref{color:rgba(144,202,249,.85);font-size:12px}\n.td-hits{font-weight:600;color:rgba(255,255,255,.4);font-size:12px}\n.eb-combo{margin-top:12px;padding:10px 12px;background:rgba(255,213,79,.08);border:1px solid rgba(255,213,79,.25);border-radius:10px;font-size:11px;color:rgba(255,255,255,.75);line-height:1.6}\n.eb-combo b{color:#ffd54f}\n.eb-note{margin-top:8px;font-size:10px;color:rgba(255,255,255,.35);line-height:1.6;flex-shrink:0}\n</style>\n<div class=\"eb\">\n  <div class=\"eb-title\">📊 七區域舔舐統計（Python 純運算，僅供顯示）</div>\n  <div class=\"eb-now\" id=\"eb-now\"></div>\n  <div class=\"eb-best\" id=\"eb-best\" style=\"display:none\"></div>\n  <table class=\"eb-tbl\">\n    <thead><tr><th>部位</th><th>累計時長 (s)</th><th>佔今日理毛比例</th><th>文獻參考值</th><th>進入次數</th></tr></thead>\n    <tbody id=\"eb-tbody\"></tbody>\n  </table>\n  <div class=\"eb-combo\" id=\"eb-combo\"></div>\n  <div class=\"eb-note\">衡量指標以「舔舐時長」與「佔今日理毛時間比例」為主，進入次數僅供輔助參考。⚠️ 頭部（HEAD）判定已停用：頭部圓心就在鼻子附近，貓只要沒有明顯把頭轉向其他部位，鼻子幾乎必然落在頭部圓圈內，無法代表「正在舔頭部」，故不納入本表統計，也不再是獨立一列。⚠️ 胸口（NECK_CHEST）判定也已停用：本系統關鍵點設計沒有獨立頸部點，鼻子在骨架上直接接到胸口，只要低頭理毛（不管實際舔的是哪個部位）鼻子幾乎必然掃過胸口附近，同樣無法代表「正在舔胸口」，故也不納入本表統計。文獻來源：Eckstein &amp; Hart (2000), <i>Applied Animal Behaviour Science</i> 68:131–140。文獻的 Face(Wash) 區域定義涵蓋「頭部＋前肢」佔 ~31%，本系統改用判定較可靠的前肢佔比近似對照（見上方對照列，非嚴格對應文獻數字）；文獻另有 Anogenital（會陰）區域佔 ~10%，本系統目前 7 區幾何未涵蓋，故無對照欄位。文獻參考值僅供合理性參考，非本系統異常判斷門檻（判斷邏輯見「貓咪主控／個體化基線」儀表板）。</div>\n</div>\n<script>\n(function(scope){\n  // 頭部（HEAD）已從陣列移除：regions.py 的 classify_zone() 已停用頭部判定\n  // （鼻子幾乎必然落在自己頭部圓圈內，不能代表「正在舔頭部」），HEAD 恒為 0，\n  // 顯示一列全零的資料沒有意義。胸口（NECK_CHEST）同樣已從陣列移除：\n  // 本系統關鍵點設計沒有獨立頸部點，鼻子在骨架上直接接到胸口（nose->chest），\n  // 只要低頭理毛（不管實際舔的是哪個部位）鼻子幾乎必然掃過胸口附近，NECK_CHEST 也恒為 0。\n  // 前肢（FORELIMB）沒有文獻可直接對照的單一數字\n  // （文獻的 Face(Wash) 是頭部＋前肢合計 31%），故 ref 留空，改在下方對照列說明。\n  var ZONES=[\n    {key:'SIDE_BACK',   label:'側/背',  color:'#43a047', ref:13},\n    {key:'ABDOMEN',     label:'腹部',   color:'#1e88e5', ref:9},\n    {key:'FORELIMB',    label:'前肢',   color:'#26c6da', ref:null},\n    {key:'HINDLIMB',    label:'後肢',   color:'#7e57c2', ref:21},\n    {key:'TAIL',        label:'尾巴',   color:'#ec407a', ref:5}\n  ];\n  var CMAP={}; ZONES.forEach(function(z){CMAP[z.key]=z;});\n\n  function fmtSec(s){if(!s||isNaN(s))return'0s';s=parseFloat(s);var m=Math.floor(s/60),sec=parseFloat((s%60).toFixed(1));return m?m+'m '+sec+'s':sec+'s';}\n  function fmtPct(v){return(v!=null&&!isNaN(v)&&isFinite(v))?parseFloat(v).toFixed(1):'—';}\n\n  function render(d){\n    if(!d) return;\n    var nowEl=document.getElementById('eb-now');\n    var z=CMAP[d.zone_name]||{label:d.zone_name||'無接觸',color:'#888'};\n    if(nowEl){\n      nowEl.innerHTML='<span class=\"eb-dot\" style=\"background:'+z.color+'\"></span>'\n        +'<span class=\"eb-now-lbl\">目前區域</span>'\n        +'<span class=\"eb-now-zone\" style=\"color:'+z.color+'\">'+(z.label||'無接觸')+'</span>'\n        +'<span class=\"eb-now-conf\">信心度 '+((d.confidence!=null)?(d.confidence*100).toFixed(0):'0')+'%</span>';\n    }\n    // 今日理毛之最：Python 端已算好 dominant_zone / dominant_pct，這裡只讀取顯示\n    var bestEl=document.getElementById('eb-best');\n    if(bestEl){\n      var dz=d.dominant_zone, dzInfo=dz?CMAP[dz]:null;\n      if(dz&&dzInfo){\n        bestEl.style.display='';\n        bestEl.innerHTML='<span class=\"eb-best-lbl\">⭐ 今日理毛之最</span>'\n          +'<span class=\"eb-best-zone\" style=\"color:'+dzInfo.color+'\">'+dzInfo.label+'</span>'\n          +'<span class=\"eb-best-pct\">佔今日理毛時間 '+fmtPct(d.dominant_pct)+'%</span>';\n      }else{ bestEl.style.display='none'; }\n    }\n    var zones=d.zones||{};\n    var tbody=document.getElementById('eb-tbody');\n    if(tbody){\n      tbody.innerHTML=ZONES.map(function(zz){\n        var s=zones[zz.key]||{hits:0,time_sec:0,pct:0};\n        var refTxt = zz.ref!=null ? ('~'+zz.ref+'%') : '—（併入合計）';\n        return '<tr><td><span class=\"eb-dot\" style=\"background:'+zz.color+'\"></span>'+zz.label+'</td>'\n          +'<td class=\"td-time\">'+fmtSec(s.time_sec)+'</td>'\n          +'<td class=\"td-pct\">'+fmtPct(s.pct)+'%</td>'\n          +'<td class=\"td-ref\">'+refTxt+'</td>'\n          +'<td class=\"td-hits\">'+(s.hits||0)+'</td></tr>';\n      }).join('');\n    }\n    // 前肢佔比：Python 端（face_wash_proxy_pct）已算好，這裡只讀取顯示。\n    // 頭部判定已停用，無法真正重現文獻「頭部＋前肢」的 Face(Wash) 定義，\n    // 改用判定較可靠的前肢佔比做近似對照（僅供參考，非嚴格對應文獻數字）。\n    var comboEl=document.getElementById('eb-combo');\n    if(comboEl){\n      var fore=(zones.FORELIMB&&zones.FORELIMB.time_sec)||0;\n      comboEl.innerHTML='🔬 <b>前肢佔比</b>：'+fmtPct(d.face_wash_proxy_pct)+'%'\n        +'（'+fmtSec(fore)+'）　近似對照文獻 Face(Wash) zone（頭部＋前肢合計）　文獻參考值 <b>~31%</b>';\n    }\n  }\n\n  scope.$watch('msg', function(msg){\n    if(msg&&msg.payload) render(msg.payload);\n  });\n})(scope);\n</script>",
